# Nunca uses el prefijo ca- aquí: el código lo deriva solo donde toca (script).
PUBLIC_ADSENSE_PUBLISHER_ID=pub-1972487168739114
# Never prefix private keys with PUBLIC_. Configure these in GitHub Secrets.
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
BZZOIRO_API_TOKEN=
MISTRAL_API_KEY=
# API oficial de Mistral. No apuntes esto a OpenCode Go: esa pasarela pide su propia clave.
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=ministral-8b-2512
WORKERS_AI_API_KEY=
WORKERS_AI_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_ACCOUNT_ID=
OPENCODE_GO_API_KEY=
# Fotos de Shorts. Las usa goatlab-gateway al elegir el partido, no GitHub Actions.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Visión de las candidatas. Los mismos valores están en fly/gateway/fly.toml.
VISION_MAX_TOKENS=15000
VISION_CALL_MS=120000
VISION_PHASE_MAX_MS=600000
# Primario en OpenCode Go. DeepSeek lleva temperature 0; el fallback MiMo no la acepta.
OPENCODE_GO_MODEL=deepseek-v4.1-flash
# Mismo gateway y misma OPENCODE_GO_API_KEY. Ningún modelo recibe reasoning_effort: todos usan el esfuerzo por defecto del proveedor.
OPENCODE_GO_FALLBACK_MODEL=mimo-v2.6-flash
# Fotos generadas solo si, tras la visión, faltan para llegar a 20. La clave va en secretos, nunca aquí con valor.
AGNES_API_KEY=
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_MAX_IMAGES=20
WORKER_URL=https://goatlab-render.fly.dev
LLM_PROVIDER_ORDER=MISTRAL_MODEL,WORKERS_AI_MODEL,OPENCODE_GO_MODEL,OPENCODE_GO_FALLBACK_MODEL
# Orden por tarea. Vacío = LLM_PROVIDER_ORDER.
ANALYSIS_PROVIDER_ORDER=MISTRAL_MODEL,WORKERS_AI_MODEL,OPENCODE_GO_MODEL,OPENCODE_GO_FALLBACK_MODEL
SCRIPT_PROVIDER_ORDER=OPENCODE_GO_MODEL,OPENCODE_GO_FALLBACK_MODEL,MISTRAL_MODEL,WORKERS_AI_MODEL
# Guiones de Shorts: cuántos partidos del ranking de relevancia por corrida (ventana de 7 días).
SCRIPT_TOP_N=5
# Presupuesto diario de predicciones API-Football (1 request por partido af-).
AF_PREDICTIONS_MAX=8
# Presupuesto diario de odds pre-partido API-Football (1 request por partido af-).
AF_ODDS_MAX=8
# Fallback de la última sección (/partido/): injuries (1) + plantillas (hasta 2)
# por partido sin extra Bzzoiro, con gemelo AF resuelto por fecha.
AF_TRENDS_FALLBACK_MAX=8
# Lecturas LLM reintentadas por corrida de refresco (solo las ausentes).
ANALYSIS_CATCHUP_MAX=3
# Partidos con lectura pendiente por corrida full/analysis-only (kickoff más próximo primero).
ANALYSIS_FULL_MAX=10
# Tope de la fase de análisis en la corrida completa. Lo que no alcance queda para el catch-up.
ANALYSIS_PHASE_MAX_MS=360000
# Partidos por llamada LLM en batch discreto (1 = solo 1x1).
ANALYSIS_BATCH_SIZE=2
# Techo de tokens del análisis 1x1 (primer intento y reintento si trunca o falla el transporte).
ANALYSIS_MAX_TOKENS=15000
ANALYSIS_RETRY_MAX_TOKENS=15000
# Techos de tokens del batch discreto (base y reintento si trunca).
ANALYSIS_BATCH_MAX_TOKENS=40000
ANALYSIS_BATCH_RETRY_MAX_TOKENS=40000
# Fallos de transporte seguidos antes de pausar un proveedor en la corrida.
LLM_PROVIDER_BREAKER_MAX=3
# Deployment only, in GitHub Secrets:
CLOUDFLARE_API_TOKEN=
# Set CLOUDFLARE_PAGES_PROJECT as a GitHub repository variable.
