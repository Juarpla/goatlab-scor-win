---
import { teamShort } from '../lib/teams.js';
const { name, teamId = null, size = 30 } = Astro.props;
const initials = teamShort(name);
// Crest by hotlink to Bzzoiro's Image API (identification use; it may be withdrawn
// at the club's request). If the file does not exist (204) or fails, the monogram remains.
---
<span class="team-logo" style={`--logo-size:${size}px`}>
  {teamId != null && <img src={`https://sports.bzzoiro.com/img/team/${teamId}/?bg=transparent`} alt="" width={size} height={size} loading="lazy" decoding="async" onerror="this.remove()" />}
  <span class="team-logo-fallback" aria-hidden="true">{initials}</span>
</span>
<style>
.team-logo{position:relative;width:var(--logo-size);height:var(--logo-size);flex-shrink:0;display:grid;place-items:center}
.team-logo img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;z-index:1}
.team-logo-fallback{font-family:var(--display);font-weight:600;font-size:calc(var(--logo-size) * .34);letter-spacing:.02em;color:var(--muted);line-height:1}
</style>
