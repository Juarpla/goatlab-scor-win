---
/**
 * TrendsStrip.astro — el partido en los medios, debajo del último anuncio.
 * Solo lo que NO está en el resto de la página: árbitro, bajas con nombre,
 * dónde ver en Latam y lo que circula. Hechos con fuente; lo ausente se
 * omite, nunca se inventa. Extra (TV/social/árbitro) solo si el pipeline
 * lo trae en trends-extra.json. Los iconos siguen el trazo 1.7 del sistema
 * y la lima queda para la señal de cada bloque.
 */
import Icon from './Icon.astro';

interface Absence { name?: string | null; reason?: string | null; team?: string | null }
interface Referee { name?: string | null; avgYellow?: number | null; avgRed?: number | null; avgFouls?: number | null; matches?: number | null }
interface Extra {
  broadcasts?: { channel?: string | null; country?: string | null }[] | null;
  social?: { account?: string | null; text?: string | null; url?: string | null; published?: string | null }[] | null;
  referee?: Referee | null;
}
interface Props {
  home: string; away: string;
  homeShort?: string; awayShort?: string;
  unavailable?: Absence[] | null;
  extra?: Extra | null;
}

const { home, away, homeShort = home, awayShort = away, unavailable = null, extra = null } = Astro.props;
const dec1 = (v: number) => v.toFixed(1).replace('.', ',');

const referee = extra?.referee?.name ? extra.referee : null;
/* Escalas de referencia por métrica: cada barra se mide contra su propio techo. */
const refBars = referee ? [
  { label: 'Amarillas', value: referee.avgYellow, max: 6 },
  { label: 'Rojas', value: referee.avgRed, max: 1 },
  { label: 'Faltas', value: referee.avgFouls, max: 30 },
].filter(bar => bar.value != null) : [];
const showReferee = Boolean(referee && refBars.length);

const rows = (Array.isArray(unavailable) ? unavailable : []).filter(p => p.name);
const homeRows = rows.filter(p => p.team === 'home');
const awayRows = rows.filter(p => p.team === 'away');
const unknownRows = rows.filter(p => p.team !== 'home' && p.team !== 'away');
const showAbsences = rows.length > 0;

const broadcasts = (extra?.broadcasts ?? []).filter(b => b.channel).slice(0, 4);
const posts = (extra?.social ?? []).filter(p => p.text && p.url).slice(0, 3);
const render = Boolean(showReferee || showAbsences || broadcasts.length || posts.length);

/* Llave del marco: una pieza por bloque presente, cada una con su icono. */
const keys: { icon: string; label: string }[] = [];
if (showReferee) keys.push({ icon: 'whistle', label: 'Quién pita' });
if (showAbsences) keys.push({ icon: 'medical', label: 'Quién falta' });
if (posts.length) keys.push({ icon: 'chat', label: 'Lo que circula' });
---

{render && (
<section class="trends" aria-labelledby="trends-title">
  <div class="trends-head">
    <h2 id="trends-title">El partido<br />en los medios.</h2>
    <p>Todo lo que rodea al juego.</p>
    {keys.length > 0 && (
      <ul class="trends-key">
        {keys.map(key => <li><Icon name={key.icon} size={15} /><span>{key.label}</span></li>)}
      </ul>
    )}
  </div>

  {(showReferee || showAbsences) && (
    <div class="trends-grid">
      {showReferee && (
        <article class="team-panel trends-panel">
          <header><h3><Icon name="whistle" size={18} />{referee?.name}</h3><span class="outline-label">Arbitraje</span></header>
          <ul class="ref-bars" role="img" aria-label={`${referee?.name}: ${refBars.map(b => `${b.label.toLowerCase()} ${dec1(b.value as number)}`).join(', ')} por partido${referee?.matches ? ` en ${referee.matches} dirigidos` : ''}`}>
            {refBars.map((bar, i) => (
              <li>
                <span class="ref-row-head"><span>{bar.label}</span><strong>{dec1(bar.value as number)}</strong></span>
                <span class="ref-track" aria-hidden="true"><b class="td-grow-r" style={`--d:${(i * 0.12).toFixed(2)}s;--w:${Math.min(100, ((bar.value as number) / bar.max) * 100).toFixed(1)}%`}></b></span>
              </li>
            ))}
          </ul>
          <p class="chapter-note">Promedios por partido{referee?.matches ? ` en ${referee.matches} dirigidos` : ''} · fuente Bzzoiro. Cada métrica usa su propia escala.</p>
        </article>
      )}
      {showAbsences && (
        <article class="team-panel trends-panel">
          <header><h3><Icon name="medical" size={18} />Bajas confirmadas</h3><span class="outline-label">{rows.length}</span></header>
          <ul class="absence-list">
            {[
              { tag: homeShort, items: homeRows },
              { tag: awayShort, items: awayRows },
              { tag: null, items: unknownRows },
            ].filter(group => group.items.length).map(group => (
              <li class="absence-group">
                {group.tag && <strong class="absence-side">{group.tag}</strong>}
                <ul>
                  {group.items.map(player => (
                    <li>{player.name}{player.reason && <small> · {player.reason}</small>}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
          <p class="chapter-note">Ausencias confirmadas, nunca estimadas · fuente Bzzoiro.</p>
        </article>
      )}
    </div>
  )}

  {(broadcasts.length > 0 || posts.length > 0) && (
    <div class="trends-extra">
      {broadcasts.length > 0 && (
        <div class="trends-block">
          <h3><Icon name="tv" size={18} />Dónde ver en Latam</h3>
          <ul>{broadcasts.map(b => <li><span class="trends-item-icon"><Icon name="tv" size={14} /></span><span><strong>{b.channel}</strong>{b.country && <small> · {b.country}</small>}</span></li>)}</ul>
        </div>
      )}
      {posts.length > 0 && (
        <div class="trends-block">
          <h3><Icon name="chat" size={18} />Lo que circula</h3>
          <ul>{posts.map(p => <li><span class="trends-item-icon"><Icon name="external" size={14} /></span><span><a href={p.url} target="_blank" rel="nofollow noopener">{p.text}</a>{p.account && <small> · {p.account}</small>}</span></li>)}</ul>
          <p class="chapter-note">Contenido externo, no verificado por GoatLab.</p>
        </div>
      )}
    </div>
  )}
</section>
)}
