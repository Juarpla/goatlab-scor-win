        </li>)}
        </ol>
         <p class="scorer-note">Si el primer gol lo hace uno de estos cinco, así se reparten las probabilidades.{scorerLeftover != null && scorerLeftover > 0.005 ? ` Fuera de esta fila queda un ${pct(scorerLeftover)} (se queda en cero + resto de plantilla).` : ''}{scorerMissingSide ? ` Sin dato de goleadores de ${teamEsDisplay(scorerMissingSide)} por ahora.` : ''}</p>
       </div>
       </div>}
      {scorerUnified.length === 0 && teamSplit && <div class="prob-scorers is-unified">
       <div class="scorer-column is-ranking">
        <h4>{storyTerm('firstScorer').term} · por equipo</h4>
        <ol>{teamSplit.map((row: any, index: number) => <li data-side={row.side}>
         <span class="scorer-rank" aria-hidden="true">{index + 1}</span>
         <span class="scorer-name">{row.name} <em>{row.side === 'home' ? 'Local' : 'Visitante'}</em></span>
         <span class="scorer-bar" style={`--share:${Math.round(row.split * 1000) / 10}%`} aria-hidden="true"></span>
         <strong>{pct(row.split)}</strong>
         <small>cálculo local · Poisson</small>
        </li>)}
        </ol>
        <p class="scorer-note">Sin dato de goleadores por equipo por ahora: el cálculo local reparte la apertura entre los dos equipos con la misma Poisson del partido.</p>
       </div>
       </div>}
      </div></section>}
     <section class="story-chapter" id="veredicto" data-chapter="veredicto"><h2>La síntesis.<br/>Con sus pesos a la vista.</h2><p>GoatLab combina sus propios cálculos con el modelo del proveedor y señales de rendimiento. Cada insumo declara su peso; lo que falta, se dice.</p><div class="legend"><span><i class="home-dot"></i>{homeEs}</span><span><i class="away-dot"></i>{awayEs}</span></div><table class="data-table"><caption class="sr-only">Valores esperados por equipo</caption><thead><tr><th>Esperados · estimación</th><th>{teamShort(match.home)}</th><th>{teamShort(match.away)}</th></tr></thead><tbody>{FORECAST_ROWS.map(row=><tr><td>{row[0]}</td><td>{forecastCell(forecastTable?.home,row)}</td><td>{forecastCell(forecastTable?.away,row)}</td></tr>)}</tbody></table>{(hasProbRows || duelAxes.length > 0) && (<div class="notes-visuals">
      <div class="prob-rows">
      {cornersDuel && <ProbabilityBar title={storyTerm('cornersDuel').term} segments={[{label: teamShort(match.home), value: cornersDuel.home, tone: 'home'}, {label: 'Empate', value: cornersDuel.draw, tone: 'draw'}, {label: teamShort(match.away), value: cornersDuel.away, tone: 'away'}]}/>}
      {raceTargets.map(target => <ProbabilityBar title={`Primero a ${target} córners`} segments={[{label: teamShort(match.home), value: cornerRace[target].home, tone: 'home'}, {label: teamShort(match.away), value: cornerRace[target].away, tone: 'away'}]}/>)}
      {marginBands.length > 0 && <ProbabilityBar title={storyTerm('cornerMargin').term} segments={marginBands}/>}
      {cardsDuel && <ProbabilityBar title={storyTerm('cardsDuel').term} segments={[{label: teamShort(match.home), value: cardsDuel.home, tone: 'home'}, {label: 'Empate', value: cardsDuel.draw, tone: 'draw'}, {label: teamShort(match.away), value: cardsDuel.away, tone: 'away'}]}/>}
      {lastTrio && <ProbabilityBar title={storyTerm('lastGoalTeam').term} segments={[{label: teamShort(match.home), value: lastTrio.home, tone: 'home'}, {label: 'Se queda en cero', value: lastTrio.noGoal, tone: 'mute'}, {label: teamShort(match.away), value: lastTrio.away, tone: 'away'}]}/>}
      </div>
       {duelAxes.length > 0 && <h3>Frente a frente</h3>}
      {duelAxes.length > 0 && <RadarDuel axes={duelAxes} homeShort={teamShort(match.home)} awayShort={teamShort(match.away)} summary={`Dominancia esperada entre ${homeEs} y ${awayEs}: reparto de tiros a puerta, faltas, fueras de juego y posesión`}/>}
       </div>)}{published && (<div class="notes-visuals">
      <span class="chapter-note">Evaluación histórica publicada sobre {evaluation.ensemble?.oneX2?.sampleSize ?? 0} partidos evaluados. Contenido informativo: son estimaciones con incertidumbre, no cuotas ni consejo para apostar.</span>
         </div>)}<p class="chapter-note">Contenido informativo y educativo sobre análisis deportivo. Las probabilidades son estimaciones con incertidumbre y no constituyen consejo ni incitación a apostar.</p><a class="text-link" href="/metodologia/">Cómo se calcula y se evalúa <Icon size={18}/></a></section>
  </div>
    <div class="story-stage"><div class="chapter-tabs" role="group" aria-label="Gráfico del análisis"><button data-stage="llegada" aria-pressed="true">Cómo llegan</button>{true && <button data-stage="resultado" aria-pressed="false">Escenarios</button>}{true && <button data-stage="goles" aria-pressed="false">Goles totales</button>}{true && <button data-stage="primer-gol" aria-pressed="false">El primer gol</button>}<button data-stage="veredicto" aria-pressed="false">La síntesis</button></div>
    <div class="stage-pane is-active" data-pane="llegada" aria-hidden="false">{hasRecent ? <FormStrip home={match.home} away={match.away} homeForm={homeRecent} awayForm={awayRecent} homeCrumbs={crumbsFor('home')} awayCrumbs={crumbsFor('away')}/> : <FormStrip home={match.home} away={match.away} homeForm={null} awayForm={null} homeCrumbs={crumbsFor('home')} awayCrumbs={crumbsFor('away')}/>}</div>
     {true && <div class="stage-pane" data-pane="resultado" aria-hidden="true" hidden>
      <h3>Escenarios de resultado</h3>
       {waffle.length > 0 ? <div class="waffle-row"><WaffleResult title="Simulación educativa: 100 escenarios" segments={waffle} summary={`Distribución en 100 escenarios simulados (${waffleSource}): ${homeEs} ${Math.round(waffleOneX2.home * 100)}, empate ${Math.round(waffleOneX2.draw * 100)}, ${awayEs} ${Math.round(waffleOneX2.away * 100)}`} note={`Cada cuadrito representa un escenario simulado con la misma distribución. Sirve para entender la incertidumbre, no para anticipar el resultado. Estimación ${waffleSource}.`}/><WaffleKicker /></div> : <p class="chapter-note">Sin lectura de proveedor para este encuentro por ahora.</p>}
    </div>}
     {true && <div class="stage-pane" data-pane="goles" aria-hidden="true" hidden>
      <h3>Goles totales</h3>
       {ladder.length > 0 && <GoalsLadder title="Umbrales de gol" rungs={ladder} summary={`Probabilidad estimada de superar cada umbral: ${ladder.map(r => `más de ${r.line} el ${pct(r.over)}`).join(', ')}`}/>}
     </div>}
    {true && <div class="stage-pane" data-pane="primer-gol" aria-hidden="true" hidden>
     <h3>El primer gol</h3>
     {race ? <figure class="prob-hero">
      <figcaption><span>¿Cuándo se abre el marcador?</span><small>Probabilidad de que el primer gol caiga en cada tramo de 15 minutos</small></figcaption>
      <svg viewBox="0 0 348 128" role="img" aria-label={`Probabilidad del primer gol por tramos; se queda en cero: ${pct(race.noGoal)}`}>
       <g class="race-grid" aria-hidden="true"><line x1="10" y1="100" x2="338" y2="100"/><line x1="10" y1="60" x2="338" y2="60"/><line x1="10" y1="20" x2="338" y2="20"/></g>
       {race.bands.map((band: any, index: number) => {
         const height = bandMax > 0 ? Math.max(2, (band.p / bandMax) * 74) : 0;
         const x = 16 + index * 54;
         const homeHeight = height * firstSplit;
         return <g class="race-bar">
          <rect class="race-home pt-grow" style={`--d:${(index * 0.1).toFixed(2)}s`} x={x} y={100 - homeHeight} width="42" height={homeHeight} rx="1.5"/>
          <rect class="race-away pt-grow" style={`--d:${(index * 0.1).toFixed(2)}s`} x={x} y={100 - height} width="42" height={height - homeHeight} rx="1.5"/>
          <text class="race-value" x={x + 21} y={100 - height - 6} text-anchor="middle">{Math.round(band.p * 100)}%</text>
          <text class="race-label" x={x + 21} y="115" text-anchor="middle">{band.from}–{band.to}′</text>
         </g>;
       })}
      </svg>
      <p class="race-foot"><span><i class="race-key race-key-home"></i>{teamShort(match.home)} {pct(race.firstHome)}</span><span><i class="race-key race-key-away"></i>{teamShort(match.away)} {pct(race.firstAway)}</span><span class="race-none">Se queda en cero: {pct(race.noGoal)}</span></p>
     </figure> : <><h3>La espera del primer gol</h3><p class="chapter-note">El cálculo de los tramos necesita la muestra completa; mientras tanto, los nombres que suelen abrirlo están abajo.</p></>}
    </div>}
     <div class="stage-pane" data-pane="veredicto" aria-hidden="true" hidden>{verdict ? <>
      <h3>La síntesis</h3>
      <div class="verdict-bars">
       {(['home','draw','away'] as const).map(side => <div class="verdict-row"><span class="verdict-label">{side === 'home' ? teamShort(match.home) : side === 'away' ? teamShort(match.away) : 'Empate'}</span><div class="verdict-track"><i style={`--p:${verdict.oneX2[side] * 100}%`}></i></div><span class="verdict-value">{Math.round(verdict.oneX2[side] * 100)}%</span></div>)}
      </div>
      {!published && <span class="outline-label">Lectura con reserva · evaluación en curso</span>}
       <p class="verdict-direction">Con estos insumos, el equipo con mayor probabilidad estimada es <strong>{direction ? teamEsDisplay(direction) : 'el empate'}</strong> — con la reserva de siempre: la muestra corta no demuestra el futuro.</p>
      </> : <><h3>La síntesis</h3><div class="verdict-bars">{displayOneX2 && (['home','draw','away'] as const).map(side => <div class="verdict-row"><span class="verdict-label">{side === 'home' ? teamShort(match.home) : side === 'away' ? teamShort(match.away) : 'Empate'}</span><div class="verdict-track"><i style={`--p:${displayOneX2[side] * 100}%`}></i></div><span class="verdict-value">{Math.round(displayOneX2[side] * 100)}%</span></div>)}</div></>}</div>
  </div>
 </div>
 <AdSlot variant="rect" slotKey="partidoStory"/>
  <PitchScene match={match} events={events}/>
  <AdSlot variant="horizontal" slotKey="partidoCancha"/>
   <ReadingBlock entry={ai}/>
   {!hasReading && <ProviderAdvice provider={prov} afPrediction={afPred} home={match.home} away={match.away}/>}
    <AdSlot variant="rect" slotKey="partidoCierre"/>
  <TrendsStrip home={match.home} away={match.away} homeShort={teamShort(match.home)} awayShort={teamShort(match.away)} unavailable={probability?.availability?.unavailablePlayers ?? match.lineups?.unavailablePlayers ?? null} extra={trendsExtra} afPrediction={afPred} />
</main>
<script>
 const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-stage]')];
 const panes=[...document.querySelectorAll<HTMLElement>('[data-pane]')];
 const chapters=[...document.querySelectorAll<HTMLElement>('[data-chapter]')];
 const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hideTimers=new WeakMap<HTMLElement,number>();
  let activeId=buttons.length ? buttons[0].dataset.stage! : '';
  let manualUntil=0;
 function activate(id:string){
  if(!id)return;
  buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.stage===id)));
  if(activeId===id)return;
  activeId=id;
  panes.forEach(p=>{
   const isTarget=p.dataset.pane===id;
   const timer=hideTimers.get(p);
   if(timer)window.clearTimeout(timer);
   if(isTarget){
    p.hidden=false;
    p.setAttribute('aria-hidden','false');
    p.classList.remove('is-leaving');
    requestAnimationFrame(()=>p.classList.add('is-active'));
   }else{
    p.setAttribute('aria-hidden','true');
    p.classList.remove('is-active');
    p.classList.add('is-leaving');
    const hide=()=>{if(p.dataset.pane!==activeId){p.classList.remove('is-leaving');p.hidden=true;}};
    if(reducedMotion)hide();
    else hideTimers.set(p,window.setTimeout(hide,240));
   }
  });
 }
 buttons.forEach(button=>button.addEventListener('click',()=>{manualUntil=Date.now()+1500;activate(button.dataset.stage!);document.getElementById(button.dataset.stage!)?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});}));
  if(!reducedMotion){let queued=false;const update=()=>{queued=false;if(Date.now()<manualUntil)return;const marker=innerWidth<761?innerHeight*.7:innerHeight*.45;let current=chapters[0];for(const chapter of chapters){if(chapter.getBoundingClientRect().top<marker)current=chapter;}if(current)activate(current.dataset.chapter!);};window.addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(update);}},{passive:true});}
  // Tendencias: una sola pasada de entrada al aparecer en vista; sin JS todo queda visible.
  try{const trends=document.querySelector('.trends');if(trends&&!reducedMotion&&'IntersectionObserver' in window){const io=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting)){trends.classList.add('is-in');io.disconnect();}},{threshold:0.2});io.observe(trends);}}catch{/* visible sin animación */}
  // Gráficos secundarios del relato: misma entrada, una sola vez por bloque.
  try{const visuals=[...document.querySelectorAll<HTMLElement>('.notes-visuals')];if(visuals.length&&!reducedMotion&&'IntersectionObserver' in window){const io=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('is-in');io.unobserve(entry.target);}}},{threshold:0.15});visuals.forEach(visual=>io.observe(visual));}}catch{/* visible sin animación */}
  document.querySelectorAll<HTMLTimeElement>('time[datetime]').forEach(time=>{const date=new Date(time.dateTime);if(!Number.isNaN(date.getTime())){time.textContent=new Intl.DateTimeFormat('es',{dateStyle:'medium',timeStyle:'short'}).format(date);const sibling=time.nextSibling;if(sibling?.textContent?.includes('(Lima)'))sibling.textContent=' (tu hora local)';}});
 // La última consulta se escribe en la hora del visitante con formato fijo (todas las apariciones).
 (()=>{
  const stamps=[...document.querySelectorAll<HTMLElement>('[data-consult]')];
  if(!stamps.length)return;
  let zone='UTC';
  try{zone=Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC';}catch{/* sin zona disponible */}
  for(const stamp of stamps){
   const iso=stamp.dataset.utc;
   if(!iso)continue;
   const date=new Date(iso);
   if(Number.isNaN(date.getTime()))continue;
   const parts=new Intl.DateTimeFormat('sv-SE',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(date);
   const read=(type:string)=>parts.find(part=>part.type===type)?.value??'';
   stamp.textContent=`${read('year')}-${read('month')}-${read('day')} ${read('hour')}:${read('minute')}`;
  }
 })();
</script>
</Layout>
