---
import { readFileSync, existsSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import { CONTENT_CATEGORIES, contentUrl } from '../lib/match-content.js';
import { matchContent } from '../lib/content-store.js';
import { attentionPlayers, playersInNarration, shortTitle, youtubeCopy } from '../lib/youtube.js';
const { match, category } = Astro.props;
const data = matchContent(match, category);
const spec = CONTENT_CATEGORIES[category];
const named = { home: match.home, away: match.away };
let description = '';
let entries = data?.prompts ?? [];
if (category === 'scripts' && data) {
  const players = attentionPlayers(data.scripts, named);
  entries = data.scripts.map(script => ({ ...script, prompt: script.narration, title: shortTitle({ ...named, n: script.n, hook: script.hook, players: [3, 4, 7, 9].includes(Number(script.n)) ? playersInNarration(script.narration, named) : [] }) }));
  const credit = existsSync('fly/render/assets/bed.txt') ? readFileSync('fly/render/assets/bed.txt', 'utf8') : '';
  const pack = `public/data/media-pack/${match.matchId}.json`;
  const attribution = existsSync(pack) ? JSON.parse(readFileSync(pack, 'utf8')).attribution : '';
  description = youtubeCopy({ lede: data.description, matchId: match.matchId, ...named, competition: match.competition, players, attribution, credit });
}
const introductions = {
  scripts: 'Diez guiones para leer y grabar. La descripción está lista para copiar en YouTube.',
  'image-prompts': 'Diez escenas referenciales para crear las imágenes del encuentro: ocho acciones de juego, las hinchadas y la presentación en el estadio.',
  'video-prompts': 'Cinco formas de dar movimiento a las imágenes. El banco compartido utiliza hasta tres clips de seis segundos.',
  'motion-prompts': 'Cinco direcciones de motion graphics para explicar los datos del encuentro. El montaje selecciona las que acompañan tu voz.',
};
---
<Layout title={`${match.home} contra ${match.away}: ${spec.label} | GoatLab`} description={introductions[category]} canonical={`https://goatlab.win${contentUrl(match.matchId, category)}`}>
  <main id="main" class="content-wrap">
    <a class="back" href={`/partido/${match.matchId}/`}>Volver al análisis del partido</a>
    <h1>{match.home}<br/><span>contra {match.away}</span></h1>
    <nav aria-label="Contenido del encuentro">
      {Object.entries(CONTENT_CATEGORIES).map(([key, value]) => <a href={contentUrl(match.matchId, key)} aria-current={key === category ? 'page' : undefined}>{value.label}</a>)}
      <a href={`/partido/${encodeURIComponent(match.matchId)}/media`}>Media</a>
    </nav>
    <h2>{spec.label}</h2>
    <p class="intro">{introductions[category]}</p>
    {data ? <>
      {description && <section class="description"><h3>Descripción para YouTube</h3><p id="youtube-description" class="copy-text">{description}</p><button type="button" data-copy="youtube-description">Copiar descripción</button></section>}
      <ol class="entries">
        {entries.map(entry => <li>
          <div class="entry-heading"><h3>{entry.title}</h3><button type="button" data-copy={`entry-${entry.n}`}>Copiar {category === 'scripts' ? 'guion' : 'prompt'} {entry.n}</button></div>
          <p id={`entry-${entry.n}`} class="copy-text" lang={category === 'scripts' ? 'es' : 'en'}>{entry.prompt}</p>
          {category === 'scripts' && <p class="note">Guion {entry.n} · {entry.words} palabras · Gancho: {entry.hook}</p>}
        </li>)}
      </ol>
      <p class="note">{category === 'scripts' ? 'Guiones' : 'Prompts'} preparados el {new Date(data.generatedAt).toLocaleDateString('es-PE', {timeZone:'America/Lima'})}.</p>
    </> : <section class="pending"><h3>Contenido en preparación</h3><p>Esta lista todavía no está disponible. Puedes consultar el análisis y las otras categorías del encuentro.</p></section>}
    <p id="copy-status" role="status" aria-live="polite"></p>
  </main>
</Layout>
<script>
  document.addEventListener('click', async event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-copy]');
    if (!button) return;
    const text = document.getElementById(button.dataset.copy ?? '')?.textContent;
    if (!text) return;
    const status = document.getElementById('copy-status');
    try { await navigator.clipboard.writeText(text); if (status) status.textContent = 'Texto copiado.'; }
    catch { if (status) status.textContent = 'No se pudo copiar. Selecciona el texto y cópialo manualmente.'; }
  });
</script>
<style>
  .content-wrap{max-width:960px;margin:auto;padding:48px 22px 80px;color:var(--ink,#edf0e6)}
  .back{display:inline-block;margin-bottom:28px;text-underline-offset:5px}
  h1{font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.8rem,7vw,5rem);line-height:1.02;letter-spacing:-.02em;margin:0 0 36px;text-wrap:balance}
  h1 span{color:var(--muted,#a4aea3)}
  nav{display:flex;gap:8px 24px;flex-wrap:wrap;padding:18px 0;border-block:1px solid #354035;margin-bottom:38px}
  nav a{padding:8px 0;text-underline-offset:8px;color:#a4aea3}
  nav a[aria-current=page]{color:#c5ed74;font-weight:700}
  h2{font-family:'Barlow Condensed',sans-serif;font-size:2.5rem;margin:0 0 12px}
  .intro,.copy-text{max-width:72ch;line-height:1.75}
  .intro{color:#a4aea3;margin-bottom:36px}
  .entries{padding-left:28px;margin:0}
  .entries li{padding:28px 0;border-top:1px solid #354035}
  .entries li::marker{font-variant-numeric:tabular-nums;color:#c5ed74;font-weight:700}
  .entry-heading{display:flex;align-items:start;justify-content:space-between;gap:20px}
  h3{font-size:1.15rem;line-height:1.4;margin:0 0 14px;text-wrap:balance}
  button{background:#222a24;color:#edf0e6;border:1px solid #354035;border-radius:5px;min-height:44px;padding:10px 14px;font:inherit;font-size:.875rem;cursor:pointer;flex-shrink:0}
  button:hover{background:#29351d;border-color:#c5ed74}
  button:focus-visible,a:focus-visible{outline:2px solid #c5ed74;outline-offset:5px}
  .copy-text{white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 20px}
  .copy-text::selection{background:#c5ed74;color:#101412}
  .note{color:#a4aea3;font-size:.875rem;line-height:1.6}
  .description,.pending{padding:24px 0 36px}
  #copy-status{position:sticky;bottom:18px;background:#181e1a;border-radius:5px;margin:0;max-width:72ch}
  #copy-status:not(:empty){padding:14px 18px}
  @media(max-width:600px){.content-wrap{padding:32px 18px 64px}.entry-heading{flex-direction:column;gap:0;margin-bottom:18px}nav{gap:8px 18px}.entries{padding-left:22px}}
</style>
