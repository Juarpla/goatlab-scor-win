---
import { AD_CLIENT, AD_SLOTS, ADS_ACTIVE } from '../config/ads';
import { isAdvertisingPage } from '../lib/page-policy.js';

interface Props {
  compact?: boolean;
  /** Block orientation: horizontal, vertical or rectangular */
  variant?: 'horizontal' | 'vertical' | 'rect';
  /** AD_SLOTS key (src/config/ads.ts) or direct numeric block ID */
  slotKey?: string;
  /** Compatibility with old calls; without an ad the block hides. */
  note?: string;
}

const { compact = false, variant, slotKey, class: className } = Astro.props;
const slotId = slotKey && /^\d+$/.test(slotKey) ? slotKey : AD_SLOTS[slotKey as keyof typeof AD_SLOTS] ?? '';
const live = ADS_ACTIVE && /^\d+$/.test(slotId) && isAdvertisingPage(Astro.url.href);
const variantClass = variant === 'horizontal' ? 'ad-horizontal' : variant === 'vertical' ? 'ad-vertical' : variant === 'rect' ? 'ad-rect' : undefined;
const adFormat = variant === 'vertical' ? 'vertical' : variant === 'rect' ? 'rectangle' : 'auto';
---
{live && <aside class:list={['ad-slot', variantClass, { compact }, className]} aria-label="Publicidad">
 <span>PUBLICIDAD</span>
 <ins class="adsbygoogle" style="display:block" data-ad-client={AD_CLIENT} data-ad-slot={slotId} data-ad-format={adFormat} data-full-width-responsive="true"></ins>
</aside>}
{live && <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>}
