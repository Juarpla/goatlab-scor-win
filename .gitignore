# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env*.local
.dev.vars

# cloudflare emulator state (regenerates on dev/preview/build)
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# raster script sources (downloaded automatically)
scripts/.cache/


# Agnes media bank (binaries; travel as an Action artifact, not in git)
public/data/media-pack/gen/
public/data/media-pack/agnes.sqlite*

# Persistent local development state and Python caches
.cache/
__pycache__/
*.pyc

# Remotion bundle (built from source)
video-render/render/remotion/dist-remotion/

# renders and local work material (binaries; never versioned)
# the folders themselves stay in git through .gitkeep
video-render/videos/*
!video-render/videos/tests/
video-render/videos/tests/*
!video-render/videos/tests/.gitkeep
video-render/work/*
!video-render/work/.gitkeep

# per-match voice recordings: docs and fixtures are tracked, recordings are not
video-render/audios/*
!video-render/audios/README.md
!video-render/audios/tests/
!video-render/audios/tests/**
