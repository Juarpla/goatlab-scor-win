// GoatLab gateway on Fly (app goatlab-gateway).
// No secrets in this file: sensitive values are ${VAR} injected as Fly secrets.
// OPENCODE_GO_MODEL and OPENCODE_GO_FALLBACK_MODEL are model ids (no provider
// prefix). start.sh defaults them when the Fly secret is unset.
// See fly/gateway/fly.toml and `fly secrets set`.
{
  gateway: {
    mode: "local",
    port: 3000,
    bind: "lan",
    auth: { token: "${OPENCLAW_GATEWAY_TOKEN}" },
    controlUi: { allowedOrigins: ["https://goatlab-gateway.fly.dev"] },
  },
  agents: {
    defaults: {
      workspace: "/home/node/.openclaw/workspace",
      model: {
        primary: "opencode-go/${OPENCODE_GO_MODEL}",
        fallbacks: ["opencode-go/${OPENCODE_GO_FALLBACK_MODEL}"],
      },
      // Per-model params only. OpenClaw does not treat this map as an allowlist
      // (that is modelPolicy.allow, which we leave unset) and does not substitute
      // ${VAR} in object keys, so this stays a fixed override for DeepSeek.
      models: {
        "opencode-go/deepseek-v4.1-flash": {
          params: { thinking: "max" },
        },
      },
    },
  },
  models: {
    mode: "merge",
    providers: {
      "opencode-go": {
        baseUrl: "https://opencode.ai/zen/go/v1",
        apiKey: "${OPENCODE_GO_API_KEY}",
        api: "openai-completions",
        models: [
          { id: "${OPENCODE_GO_MODEL}", name: "${OPENCODE_GO_MODEL}" },
          { id: "${OPENCODE_GO_FALLBACK_MODEL}", name: "${OPENCODE_GO_FALLBACK_MODEL}" },
        ],
      },
    },
  },
  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "allowlist",
      allowFrom: ["1295170307"],
      capabilities: { inlineButtons: "allowlist" },
      webhookUrl: "https://goatlab-gateway.fly.dev/telegram-webhook",
      webhookSecret: "${TELEGRAM_WEBHOOK_SECRET}",
      webhookHost: "0.0.0.0",
      webhookPort: 8787,
    },
  },
}
