---
import { readdirSync, readFileSync } from 'node:fs';
import Layout from '../../../layouts/Layout.astro';

export function getStaticPaths() {
  let files = [];
  try {
    files = readdirSync('public/data/youtube-scripts').filter(f => f.endsWith('.json'));
  } catch {
    return [];
  }
  return files.map(file => {
    const data = JSON.parse(readFileSync(`public/data/youtube-scripts/${file}`, 'utf8'));
    return { params: { id: data.matchId }, props: { data } };
  });
}

const { data } = Astro.props;
const title = `${data.home} contra ${data.away}: guiones del Short | GoatLab`;
---

<Layout title={title} description={`Diez guiones de Short y descripción lista para YouTube del ${data.home} contra ${data.away}.`} canonical={`https://goatlab.win/partido/${data.matchId}/youtube`}>
  <main id="main" class="wrap">
    <p><a href={`/partido/${data.matchId}/`}>← Volver al análisis del partido</a></p>
    <h1>{data.home} contra {data.away}</h1>
    <p>Diez guiones de menos de 50 segundos y la descripción lista para YouTube, con enlace a esta web.</p>
    <h2>Descripción para YouTube</h2>
    <pre>{data.description}</pre>
    <h2>Guiones para leer en voz alta</h2>
    <ol>
      {data.scripts.map((script) => (
        <li>
          <p>{script.narration}</p>
          <p><small>Guion {script.n} · {script.words} palabras (~{Math.round(script.words / 2.5)}s) · gancho: {script.hook}</small></p>
        </li>
      ))}
    </ol>
  </main>
</Layout>
