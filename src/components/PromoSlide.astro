---
import Icon from './Icon.astro';
---

<section class="promo-slide">
  <div class="promo-copy">
    <h2>Más contexto.<br /><span>Otra forma de verlo.</span></h2>
    <p>La ventana de la semana con forma real, estadísticas del encuentro y análisis que declaran sus límites.</p>
    <a class="primary-button" href="/encuentros/">Explorar los encuentros <Icon /></a>
    <small class="promo-note">Sin enlaces a casas de apuestas. Siempre.</small>
  </div>
  <div class="promo-phone" aria-hidden="true">
    <svg viewBox="0 0 220 430" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="214" height="424" rx="30" fill="var(--raised)" stroke="var(--line)" stroke-width="1.5"/>
      <rect x="11" y="11" width="198" height="408" rx="24" fill="var(--bg)"/>
      <rect x="82" y="22" width="56" height="13" rx="6.5" fill="var(--raised)"/>
      <circle cx="26" cy="54" r="3.5" fill="var(--accent)"/>
      <rect x="36" y="50" width="46" height="8" rx="4" fill="var(--raised)"/>
      <rect x="90" y="50" width="30" height="8" rx="4" fill="var(--raised)"/>
      <rect x="20" y="78" width="180" height="118" rx="10" fill="var(--surface)"/>
      <rect x="32" y="90" width="42" height="13" rx="4" stroke="var(--line)" stroke-width="1.5"/>
      <rect x="32" y="114" width="60" height="9" rx="4.5" fill="var(--raised)"/>
      <rect x="32" y="134" width="48" height="9" rx="4.5" fill="var(--raised)"/>
      <rect x="156" y="118" width="32" height="22" rx="4" fill="var(--bg)" stroke="var(--line)" stroke-width="1.5"/>
      <rect x="32" y="160" width="10" height="10" rx="2" fill="#29351d"/>
      <rect x="46" y="160" width="10" height="10" rx="2" fill="#303732"/>
      <rect x="60" y="160" width="10" height="10" rx="2" fill="#3b2824"/>
      <rect x="20" y="216" width="74" height="8" rx="4" fill="var(--raised)"/>
      <rect x="20" y="232" width="180" height="16" rx="8" fill="var(--bg)" stroke="var(--line)" stroke-width="1.5"/>
      <rect class="ct-fill" x="22" y="234" width="176" height="12" rx="6" fill="var(--accent)"/>
      <rect x="20" y="266" width="120" height="8" rx="4" fill="var(--raised)"/>
      <rect x="20" y="282" width="88" height="8" rx="4" fill="var(--raised)"/>
      <rect x="20" y="306" width="180" height="64" rx="10" fill="var(--surface)"/>
      <path d="M32 358H188" stroke="var(--line)" stroke-width="1.5"/>
      <rect x="38" y="336" width="10" height="22" rx="3" fill="var(--away)"/>
      <rect x="56" y="324" width="10" height="34" rx="3" fill="var(--accent)"/>
      <rect x="74" y="342" width="10" height="16" rx="3" fill="var(--away)"/>
      <rect x="80" y="402" width="60" height="4" rx="2" fill="var(--raised)"/>
    </svg>
  </div>
</section>
