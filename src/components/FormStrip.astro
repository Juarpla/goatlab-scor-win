---
import { teamShort } from '../lib/teams.js';
/**
 * "Cómo llegan al encuentro" como SVG dinámico: una fila por equipo con sus
 * últimos 5 partidos (marcador + rival abreviado), generada desde los datos —
 * ningún trazo estático. Mismo lenguaje que los chips de la portada (tintas
 * G/E/P, Manrope tabular) y misma accesibilidad que el gráfico anterior
 * (`role="img"` con la serie enumerada). La parrilla es fija (5 huecos, el
 * más reciente a la derecha); lo que falta se dibuja como hueco vacío.
 * Sin serie registrada, la fila cae a un blueprint en construcción (andamio
 * discontinuo, línea dibujándose en bucle, nodos parpadeantes, cian neutro)
 * con migajas reales del equipo (`homeCrumbs`/`awayCrumbs`) y expectativa
 * honesta; con movimiento reducido todo queda estático.
 */
const { home, away, homeForm = null, awayForm = null, homeCrumbs = [], awayCrumbs = [] } = Astro.props;
const SLOTS = 5;
const CELL_W = 72, CELL_H = 56, GAP = 6, PAD = 8;
const HEAD_H = 26, EMPTY_H = 56, ROW_GAP = 18;
const TONES = {
  G: { bg: '#29351d', fg: '#d2eea7' },
  E: { bg: '#303732', fg: '#c7cfc6' },
  P: { bg: '#3b2824', fg: '#e9b4a3' },
};
const DOT = { home: '#c5ed74', away: '#8ca6bf' };
// Más antiguo a la izquierda, el último a la derecha (lectura del sitio).
const gamesOf = form => form.goalsFor.map((scored, index) => ({
  letter: form.form[index],
  scored,
  conceded: form.goalsAgainst[index],
  rival: form.rivals[index],
  date: String(form.dates[index] ?? '').slice(0, 10),
})).reverse();
const summaryOf = form => `${form.form.filter(letter => letter === 'G').length}G · ${form.goalsFor.reduce((sum, value) => sum + value, 0)} goles`;
const width = PAD * 2 + SLOTS * CELL_W + (SLOTS - 1) * GAP;
let cursor = 0;
const blocks = [
  { name: home, form: homeForm, dot: DOT.home, crumbs: homeCrumbs },
  { name: away, form: awayForm, dot: DOT.away, crumbs: awayCrumbs },
].map(side => {
  const games = side.form ? gamesOf(side.form) : null;
  const block = { ...side, games, slots: [...Array(Math.max(0, SLOTS - (games?.length ?? 0))).fill(null), ...(games ?? [])], y: cursor };
  cursor += HEAD_H + (games ? CELL_H : EMPTY_H) + ROW_GAP;
  return block;
});
const height = cursor - ROW_GAP + 4;
const count = Math.max(homeForm?.played ?? 0, awayForm?.played ?? 0);
const emptyBlocks = blocks.filter(block => !block.games);
const ariaSeries = blocks.map(block => block.games
  ? `${block.name}, ${block.games.map(game => `${game.scored}-${game.conceded}`).join(', ')}`
  : `${block.name}: sin serie registrada, en un futuro tendremos datos`).join('; ');
/* Fila blueprint: andamio discontinuo con la línea dibujándose en bucle y
   dos nodos parpadeantes; geometría relativa al ancho, nada estático. */
const blueprint = y => {
  const x0 = PAD + 12, x1 = width - PAD - 12, span = x1 - x0, mid = y + 20;
  const peakX = x0 + span * 0.44, peakY = mid - 9;
  return {
    frameY: y, mid,
    line: `M ${x0} ${mid + 8} L ${x0 + span * 0.18} ${mid + 4} L ${x0 + span * 0.3} ${mid + 8} L ${peakX} ${peakY}`,
    scaffold: `M ${peakX} ${peakY} H ${x1}`,
    nodes: [{ cx: x0 + span * 0.3, cy: mid + 8, d: '0.9s' }, { cx: peakX, cy: peakY, d: '1.8s' }],
  };
};
---
<div class="comparison form-strip">
  <div class="chart-heading"><h3>Cómo llegan al encuentro</h3><span>{count > 0 ? `Últimos ${count} partidos · resultados reales` : 'Aún sin partidos registrados · en un futuro tendremos datos'}</span></div>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Goles reales en los últimos partidos: ${ariaSeries}`}>
    {blocks.map(block => (
      <g>
        <circle cx={PAD + 4} cy={block.y + 9} r="4" fill={block.dot} />
        <text class="fs-name" x={PAD + 14} y={block.y + 15}>{block.name}</text>
        {block.games && <text class="fs-total" x={width - PAD} y={block.y + 15} text-anchor="end">{summaryOf(block.form)}</text>}
        {!block.games && <text class="fs-total" x={width - PAD} y={block.y + 15} text-anchor="end">Sin serie registrada por ahora.</text>}
        {block.games ? block.slots.map((game, index) => {
          const x = PAD + index * (CELL_W + GAP);
          const y = block.y + HEAD_H;
          if (!game) return <g aria-hidden="true"><rect x={x} y={y} width={CELL_W} height={CELL_H} rx="6" class="fs-slot" /><text class="fs-gap" x={x + CELL_W / 2} y={y + 34} text-anchor="middle">–</text></g>;
          const tone = TONES[game.letter] ?? TONES.E;
          return <g>
            <title>{`${game.scored}-${game.conceded} contra ${game.rival} (${game.date})`}</title>
            <rect x={x} y={y} width={CELL_W} height={CELL_H} rx="6" fill={tone.bg} />
            <text class="fs-score" x={x + CELL_W / 2} y={y + 23} text-anchor="middle" fill={tone.fg}>{game.scored}-{game.conceded}</text>
            <text class="fs-rival" x={x + CELL_W / 2} y={y + 41} text-anchor="middle">{teamShort(game.rival)}</text>
          </g>;
        }) : (() => { const bp = blueprint(block.y + HEAD_H); return <g>
          <title>{`${block.name}: en un futuro tendremos datos, aún sin partidos registrados`}</title>
          <rect x={PAD} y={bp.frameY} width={width - PAD * 2} height="36" rx="6" class="suc-frame" />
          <line x1={PAD + 12} x2={width - PAD - 12} y1={bp.mid - 9} y2={bp.mid - 9} class="suc-grid" />
          <line x1={PAD + 12} x2={width - PAD - 12} y1={bp.mid + 8} y2={bp.mid + 8} class="suc-grid" />
          <path d={bp.line} pathLength={100} class="suc-line" />
          <path d={bp.scaffold} class="suc-scaffold" />
          {bp.nodes.map(node => <circle cx={node.cx} cy={node.cy} r="3.5" class="suc-node" style={`--d:${node.d}`} />)}
          <text class="suc-tag" x={PAD} y={bp.frameY + 51}>En un futuro tendremos datos</text>
        </g>; })()}
      </g>
    ))}
  </svg>
  {emptyBlocks.filter(block => block.crumbs?.length).map(block => (
    <p class="suc-crumbs"><strong>{block.name}</strong>{block.crumbs.map(crumb => <span>{crumb}</span>)}</p>
  ))}
  {emptyBlocks.length > 0 && <p class="suc-expect">Sus últimos 5 aparecerán aquí en cuanto {emptyBlocks.length > 1 ? 'acumulen' : 'acumule'} partidos registrados.</p>}
  <p class="form-strip-note">Marcador desde la óptica de cada equipo: verde ganó, gris empató, rojo perdió.</p>
</div>
<style>
  .form-strip svg { width: 100%; height: auto; display: block; margin-top: 18px; }
  .fs-name { font: 600 16px var(--display); fill: var(--text); }
  .fs-total { font: 500 11px var(--body); fill: var(--muted); font-variant-numeric: tabular-nums; }
  .fs-score { font: 700 13px var(--body); font-variant-numeric: tabular-nums; }
  .fs-rival { font: 500 9.5px var(--body); fill: var(--muted); font-variant-numeric: tabular-nums; }
  .fs-gap { font: 500 13px var(--body); fill: var(--muted); }
  .fs-slot { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 3 3; }
  .suc-frame { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 4 3; }
  .suc-grid { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 4; opacity: 0.55; }
  .suc-line { fill: none; stroke: #8ca6bf; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 0; animation: suc-draw 2.8s linear infinite; }
  @keyframes suc-draw { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
  .suc-scaffold { fill: none; stroke: #8ca6bf; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 2 5; opacity: 0.45; }
  .suc-node { fill: #8ca6bf; animation: suc-blink 2.8s ease-in-out infinite; animation-delay: var(--d, 0s); }
  @keyframes suc-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) { .suc-line, .suc-node { animation: none; } }
  .suc-tag { font: 400 10.5px var(--body); fill: var(--muted); font-variant-numeric: tabular-nums; }
  .suc-crumbs { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 11px; color: var(--muted); margin: 12px 0 0; }
  .suc-crumbs strong { color: var(--text); font-weight: 650; margin-right: 2px; }
  .suc-crumbs span { border: 1px solid var(--line); border-radius: 5px; padding: 2px 8px; font-variant-numeric: tabular-nums; }
  .suc-expect { font-size: 11px; color: var(--muted); margin: 10px 0 0; }
  .form-strip-note { font-size: 10px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 12px; margin-top: 14px; }
</style>
