---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FormStrip from '../../components/FormStrip.astro';
import AdSlot from '../../components/AdSlot.astro';
import TeamJersey from '../../components/TeamJersey.astro';
import PitchScene from '../../components/PitchScene.astro';
import ReadingBlock from '../../components/ReadingBlock.astro';
import ProviderAdvice from '../../components/ProviderAdvice.astro';
import ProbabilityBar from '../../components/ProbabilityBar.astro';
import ExtraMarkets from '../../components/ExtraMarkets.astro';
import WaffleResult from '../../components/WaffleResult.astro';
import WaffleKicker from '../../components/WaffleKicker.astro';
import GoalsLadder from '../../components/GoalsLadder.astro';
import ScorePodium from '../../components/ScorePodium.astro';
import RadarDuel from '../../components/RadarDuel.astro';
import TrendsStrip from '../../components/TrendsStrip.astro';
import { storyTerm } from '../../lib/story-dictionary.js';
import { normalizeReading } from '../../lib/reading.js';
import { findAnalysis } from '../../lib/analysis.js';
import { competitions, FINISHED_STATUSES } from '../../lib/football.js';
import { teamShort, teamCompact, teamEsDisplay } from '../../lib/teams.js';
import { teamForm, bakedForm } from '../../lib/form.js';
import { roundFecha, findStandingRow, topScorerFor } from '../../lib/series-crumbs.js';
import { ensemble } from '../../lib/predictions.js';
import { normalizeOneX2, deriveDoubleChance, deriveDnb, pickDecisive } from '../../lib/provider-markets.js';
import { topScorerSplit } from '../../lib/probabilities.js';
import { locateMatch, competitionFallback, fallbackRegionLayout } from '../../lib/venues.js';
import { teamColors } from '../../lib/team-colors.js';
import fixtures from '../../../public/data/fixtures.json';
import analyses from '../../../public/data/llm-analysis.json';
import results from '../../../public/data/results.json';
import standingsData from '../../../public/data/standings.json';
import scorersData from '../../../public/data/scorers.json';
import history from '../../../public/data/history-stats.json';
import evaluation from '../../../public/data/evaluation-report.json';
import '../../styles/partido.css';

export function getStaticPaths() {
  // URL canónica: webId (`home-vs-away-fecha`). El id de proveedor se sigue
  // emitiendo para no romper enlaces compartidos (mismo contenido).
  return fixtures.matches.flatMap(match => {
    const web = { params: { id: match.webId ?? match.id }, props: { match } };
    return match.webId && match.webId !== match.id
      ? [web, { params: { id: match.id }, props: { match } }]
      : [web];
  });
}
const {match} = Astro.props;
const competition = competitions.find(c=>c.id===match.competition)?.name;
const homeEs = teamEsDisplay(match.home);
const awayEs = teamEsDisplay(match.away);
const homeForm = teamForm(results.results, match.home);
const awayForm = teamForm(results.results, match.away);
/* Lo que ya jugaron: siempre últimos 5 por equipo (horneado del pipeline
   primero, base local después); el H2H solo vive en el JSON/síntesis. */
const homeRecent = bakedForm(match.lastMatches?.home, match.home) ?? teamForm(results.results, match.home);
const awayRecent = bakedForm(match.lastMatches?.away, match.away) ?? teamForm(results.results, match.away);
const hasRecent = Boolean(homeRecent?.played || awayRecent?.played);
const tableHome = homeRecent;
const tableAway = awayRecent;
const events = match.events;
const finished = FINISHED_STATUSES.has(match.status);
const statusLabel = finished ? 'Finalizado' : match.status === 'NS' ? 'Programado' : 'En juego';
const ai = findAnalysis(analyses as Record<string, {summary:unknown;limitations:unknown}>, match)?.entry;
/* Sin lectura LLM (fallo de proveedores o presupuesto), la vista cae al
   fallback de proveedores; `normalizeReading` decide lo mostrable. */
const hasReading = Boolean(normalizeReading(ai));
const EVENT_LABELS = { goal: 'Gol', card: 'Tarjeta', sub: 'Cambio' };
/* Tabla de estimación: valores esperados con coma latina; lo nulo se pinta '—'. */
const count1 = v => v == null ? '—' : Number(v).toFixed(1).replace('.', ',');
const FORECAST_ROWS = [
  ['Posesión', 'possession', v => v == null ? '—' : `${Math.round(v)}%`],
  ['Tiros', 'shots', count1],
  ['Tiros a puerta', 'shotsOnTarget', count1],
  ['Goles esperados (xG)', 'xg', v => v == null ? '—' : Number(v).toFixed(2).replace('.', ',')],
  ['Córners', 'corners', count1],
  ['Faltas', 'fouls', count1],
  ['Tarjetas amarillas', 'yellowCards', count1],
  ['Tarjetas rojas', 'redCards', count1],
  ['Fueras de juego', 'offsides', count1],
];
const forecastCell = (side, row) => {
  const [label, key, format] = row;
  const value = side?.[key];
  return format ? format(value) : value ?? '—';
};
const homeTotals = tableHome ? tableHome.goalsFor.reduce((a:number,b:number)=>a+b,0) : 0;
const awayTotals = tableAway ? tableAway.goalsFor.reduce((a:number,b:number)=>a+b,0) : 0;
const homeWins = tableHome ? tableHome.form.filter((x:string)=>x==='G').length : 0;
const awayWins = tableAway ? tableAway.form.filter((x:string)=>x==='G').length : 0;
const recentMax = Math.max(tableHome?.played ?? 0, tableAway?.played ?? 0);
const recentAvg = (totals:number, recent) => recent ? (totals/recent.played).toFixed(1) : '—';

/* Cabecera: última consulta con la hora del paso de datos; el cliente la reescribe al huso del visitante. */
const consultUtc = fixtures.updatedAt ? `${fixtures.updatedAt.slice(0,10)} ${fixtures.updatedAt.slice(11,16)} UTC` : '—';

/* Sede y zoom del estadio: sin club en el catálogo, el mapa cae a la región
   de la competición (país con pin al centro en ligas nacionales, continente
   sin pin en las continentales) y el pie declara la sede como no ubicada. */
const location = locateMatch(match);
const located = Boolean(location?.zoom);
const fallback = fallbackRegionLayout(competitionFallback(match.competition));
const venueMap = location?.zoom ?? fallback;
const venuePin = location?.zoom
  ? { x: location.zoom.pinX, y: location.zoom.pinY }
  : fallback.pinX != null ? { x: fallback.pinX, y: fallback.pinY } : null;
const fallbackPlace = [match.venue, match.venueCity].filter(Boolean).join(' · ');
const venueCaption = located
  ? `${location.stadium ?? location.city} · ${location.city}, ${location.country}`
  : `${fallbackPlace ? `${fallbackPlace} · ` : ''}sede sin ubicación en el mapa · referencia: ${fallback.label}`;

/* Probabilidades horneadas por el pipeline (un JSON por partido, revisable a mano). */
const probabilityFiles = import.meta.glob('../../../public/match-probabilities/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const probability: any = probabilityFiles[`../../../public/match-probabilities/${match.id}.json`] ?? null;
/* Tendencias: hechos locales + extra del pipeline (retransmisiones/social); sin archivo, solo local. */
const trendsFiles = import.meta.glob('../../../public/data/trends-extra.json', { eager: true, import: 'default' }) as Record<string, any>;
const trendsExtra: any = (Object.values(trendsFiles)[0] as any)?.[match.id] ?? null;
const markets = probability?.markets ?? null;
const afOddsM = probability?.afOdds ?? null;
const xgM = probability?.xgMarkets ?? null;
const afPred = probability?.afPrediction ?? null;
const race = probability?.firstGoal ?? null;
const scorerRows = probability?.scorers ?? null;
const marketConsensus = probability?.market ?? (match as any).marketConsensus ?? null;
const pct = (value: number | null | undefined) => value == null ? '—' : `${Math.round(value * 100)}%`;
/* Decimales en coma latina para las lecturas nuevas (goles esperados). */
const dec = (value: number | null | undefined, digits = 1) => value == null ? '—' : Number(value).toFixed(digits).replace('.', ',');
const bandMax = race ? Math.max(...race.bands.map((band: any) => band.p)) : 0;
const firstSplit = race && (race.firstHome + race.firstAway) > 0 ? race.firstHome / (race.firstHome + race.firstAway) : 0.5;
const exactAll = xgM?.exactScores ?? markets?.exactScores ?? [];
/* El podio reparte 100 entre los 5 mostrados; la `p` absoluta queda en el JSON. */
const podiumRaw = exactAll.slice(0, 5);
const hasShare = podiumRaw.length > 0 && podiumRaw.every((score: any) => typeof score?.share === 'number');
const podiumSum = hasShare ? 1 : podiumRaw.reduce((total: number, score: any) => total + (score?.p ?? 0), 0);
const podiumFive = podiumRaw.map((score: any) => ({ ...score, p: hasShare ? score.share : podiumSum > 0 ? score.p / podiumSum : 0 }));
const exactTop = podiumFive.slice(0, 3);
const exactRest = podiumFive.slice(3);
const homeKit = teamColors(match.home);
const awayKit = teamColors(match.away);

/* Capítulos siempre visibles (tolerancia cero): llegada + números + resultado +
   goles + primer gol + síntesis. Cada bloque declara su procedencia. */
const lambdas = probability?.inputs?.lambdas ?? null;
const lambdaSource = probability?.inputs?.lambdaSource ?? (lambdas ? 'Poisson' : null);
/* Si el JSON aún no trae escenarios (corrida anterior), la lectura del consenso
   sostiene resultado/goles/ambos-anotan como mínimo honesto hasta la próxima corrida. */
const displayOneX2 = markets?.oneX2 ?? marketConsensus?.oneX2 ?? null;
const hasMarkets = Boolean(markets?.oneX2 || marketConsensus?.oneX2);
const totals = markets?.totals ?? null;
/* Ambos anotan con Bzzoiro al frente; AF en medio; Poisson propio al cierre. */
const bttsBase = markets?.btts ?? (marketConsensus?.btts != null ? { yes: marketConsensus.btts, no: 1 - marketConsensus.btts } : null);
const provenance = lambdaSource === 'Poisson' ? 'Modelo' : lambdaSource === 'Bzzoiro-xG' ? 'Modelo' : lambdaSource === 'Media-liga' ? 'Estimación' : marketConsensus ? 'Consenso externo' : 'Modelo';
const cleanM = xgM?.cleanSheet ?? markets?.cleanSheet ?? null;
const prov = probability?.provider ?? null;
/* Escenarios de resultado: lectura de proveedores. El waffle usa Bzzoiro con
   fallback a API-Football; local-o-empate y resultado-sin-empate usan la más decisiva
   (|local − visita| mayor; empate → Bzzoiro). Ningún proveedor trae esas combinadas:
   se derivan del resultado (local-o-empate = local+empate, visita-o-empate = empate+visita,
   sin-empate.local = local/(local+visita)). */
const bzOneX2 = normalizeOneX2(prov?.oneX2 ?? null);
const afOneX2 = normalizeOneX2(probability?.afPrediction?.percent ?? null);
const waffleOneX2 = bzOneX2 ?? afOneX2 ?? null;
const waffleSource = bzOneX2 ? 'Bzzoiro' : afOneX2 ? 'API-Football' : null;
const dcPick = pickDecisive(bzOneX2, afOneX2);
const dcSourceOneX2 = dcPick === 'af' ? afOneX2 : dcPick === 'bz' ? bzOneX2 : null;
const dcM = dcSourceOneX2 ? deriveDoubleChance(dcSourceOneX2) : null;
const dnbM = dcSourceOneX2 ? deriveDnb(dcSourceOneX2) : null;
const hasScorerData = Boolean(scorerRows && (scorerRows.home?.length || scorerRows.away?.length));
const hasFirst = Boolean(race || hasScorerData || displayOneX2);
/* Ranking único de goleadores: reparto del 100% entre los 5 con mayor probabilidad
   de abrir el marcador. `topScorerSplit` une ambos equipos, ordena por `first`
   y renormaliza; el JSON conserva los valores absolutos. */
const scorerSplit = hasScorerData ? topScorerSplit(scorerRows, { top: 5, noGoal: race?.noGoal ?? null }) : null;
const scorerUnified = scorerSplit?.rows ?? [];
const scorerLeftover = scorerSplit?.leftover ?? null;
const scorerMissingSide = hasScorerData && (!scorerRows.home?.length || !scorerRows.away?.length)
  ? (!scorerRows.home?.length ? match.home : match.away) : null;
/* Nivel 4 (Poisson local): sin nombres por equipo, el reparto va por equipos
   con la misma λ de la carrera; nunca se inventan goleadores. */
const teamSplit = !scorerUnified.length && race && (race.firstHome + race.firstAway) > 0
  ? [
      { side: 'home', name: homeEs, split: race.firstHome / (race.firstHome + race.firstAway) },
      { side: 'away', name: awayEs, split: race.firstAway / (race.firstHome + race.firstAway) },
    ].sort((a, b) => b.split - a.split)
  : null;
/* Goles totales con Bzzoiro al frente, AF en medio y Poisson al
   cierre; ningún umbral queda vacío mientras haya cálculo propio. */
const round3 = (value: number) => Math.round(value * 1000) / 1000;
const rung = (line: string, over: number | null | undefined) => ({ line, over: over ?? null, under: over != null ? round3(1 - over) : null });
const ladder = [
  rung('1.5', prov?.over15 ?? totals?.over15 ?? null),
  rung('2.5', prov?.over25 ?? afOddsM?.over25 ?? totals?.over25 ?? marketConsensus?.over25 ?? null),
  rung('3.5', prov?.over35 ?? totals?.over35 ?? null),
];
const bttsYes = prov?.btts ?? afOddsM?.btts ?? bttsBase?.yes ?? null;
const bttsM = bttsYes != null ? { yes: bttsYes, no: round3(1 - bttsYes) } : null;
/* Fichas de goles: marcador esperado Bzzoiro más techos y mínimo de AF. */
const expectedScore = prov?.score ? String(prov.score).replace('-', '–') : null;
const fmtGoal = (value: number) => Number.isInteger(value) ? String(value) : String(Math.round(value * 10) / 10);
const ceilingOf = (raw: unknown) => {
  const v = typeof raw === 'string' ? Number(raw.replace('+', '')) : NaN;
  if (!Number.isFinite(v)) return null;
  return v < 0 ? `≤${fmtGoal(Math.abs(v) - 0.5)}` : `≥${fmtGoal(v + 0.5)}`;
};
const ceilingHome = ceilingOf(afPred?.goals?.home);
const ceilingAway = ceilingOf(afPred?.goals?.away);
const minTotal = (() => {
  const v = typeof afPred?.underOver === 'string' ? Number(afPred.underOver.replace('+', '')) : NaN;
  if (!Number.isFinite(v)) return null;
  const goals = v < 0 ? Math.abs(v) - 0.5 : v + 0.5;
  return `${fmtGoal(goals)} ${goals === 1 ? 'gol' : 'goles'}`;
})();
const waffle = waffleOneX2 ? [
  { label: teamShort(match.home), value: waffleOneX2.home, tone: 'home' as const },
  { label: 'Empate', value: waffleOneX2.draw, tone: 'draw' as const },
  { label: teamShort(match.away), value: waffleOneX2.away, tone: 'away' as const },
] : [];

/* Valores estimados: valores esperados siempre con muestra; duelos en
   porcentaje solo cuando su insumo supera la evaluación histórica. */
const forecast = probability?.statsForecast ?? null;
const dominance = probability?.dominance ?? null;
const hasForecast = Boolean(forecast && (forecast.home || forecast.away));
const forecastFallback = !hasForecast && lambdas ? { home: { corners: null, shots: null, shotsOnTarget: null, xg: lambdas.home, yellowCards: null }, away: { corners: null, shots: null, shotsOnTarget: null, xg: lambdas.away, yellowCards: null } } : null;
const forecastTable = forecast ?? forecastFallback;
const statEval = evaluation?.stats?.metrics ?? {};
const statOk = (key: string) => statEval[key]?.published === true;
/* Duelos derivados: solo con ritmos propios del equipo en esa métrica.
   Con relleno de media, el Poisson degenera en moneda al aire. */
const srcOf = (side: string, metric: string) => (forecast as any)?.sources?.[side]?.[metric] ?? null;
const teamSourced = (metric: string) => ['Bzzoiro', 'AF'].includes(srcOf('home', metric)) && ['Bzzoiro', 'AF'].includes(srcOf('away', metric));
const cornersOk = hasForecast && teamSourced('corners') && statOk('corners');
const cornersDuel = cornersOk ? dominance?.cornersDuel ?? null : null;
const cornerRace = cornersOk ? dominance?.cornerRace ?? null : null;
const cornerMargin = cornersOk ? dominance?.cornerMargin ?? null : null;
const cardsDuel = hasForecast && teamSourced('yellowCards') && statOk('yellowCards') ? dominance?.cardsDuel ?? null : null;
const lastTrio = hasForecast && evaluation?.gate?.poissonOk ? dominance?.lastGoal ?? null : null;
/* Reparto 0–1 entre ambos para el radar; nulo cuando falta un lado. */
const share = (home: number | null | undefined, away: number | null | undefined) =>
  home != null && away != null && home + away > 0 ? home / (home + away) : null;
const mkAxis = (label: string, home: number | null | undefined, away: number | null | undefined) => {
  const s = share(home, away);
  return s == null ? null : { label, home: s, away: 1 - s };
};
/* Radar desde Esperados · pronóstico: solo ejes con ritmos propios. */
const duelAxes = hasForecast ? [
  teamSourced('shotsOnTarget') ? mkAxis('A puerta', forecast.home.shotsOnTarget, forecast.away.shotsOnTarget) : null,
  teamSourced('fouls') ? mkAxis('Faltas', forecast.home.fouls, forecast.away.fouls) : null,
  teamSourced('offsides') ? mkAxis('Fueras de juego', forecast.home.offsides, forecast.away.offsides) : null,
  teamSourced('possession') ? mkAxis('Posesión', forecast.home.possession, forecast.away.possession) : null,
].filter(Boolean) : [];
const raceTargets = [3, 5, 7].filter(target => cornerRace?.[target]?.home != null);
const marginBands = cornerMargin ? [
  { label: `${teamShort(match.home)} por 3 o más`, value: cornerMargin.home3plus, tone: 'home' as const },
  { label: `${teamShort(match.home)} por 1–2`, value: cornerMargin.home12, tone: 'home' as const },
  { label: 'Iguales', value: cornerMargin.level, tone: 'draw' as const },
  { label: `${teamShort(match.away)} por 1–2`, value: cornerMargin.away12, tone: 'away' as const },
  { label: `${teamShort(match.away)} por 3 o más`, value: cornerMargin.away3plus, tone: 'away' as const },
] : [];
const hasProbRows = Boolean(cornersDuel || raceTargets.length > 0 || marginBands.length > 0 || cardsDuel || lastTrio);

/* Síntesis GoatLab: combina modelo propio, CatBoost, consenso externo y señales; los pesos siempre a la vista. */
const absentCount = side => (match.lineups?.unavailablePlayers ?? []).filter(player => player.team === side).length;
const unavailable = match.lineups?.unavailablePlayers?.length ? { home: absentCount('home'), away: absentCount('away') } : null;
const verdict = ensemble({ results: results.results, history: history.rows, h2h: match.h2h ?? null, catboost: match.modelPrediction ?? null, market: marketConsensus, home: match.home, away: match.away, homeForm, awayForm, unavailable });
const published = Boolean(evaluation?.published) && Boolean(verdict);
const direction = verdict ? (verdict.oneX2.home >= verdict.oneX2.draw && verdict.oneX2.home >= verdict.oneX2.away ? match.home : verdict.oneX2.away > verdict.oneX2.draw ? match.away : null) : null;

/* Tarjetas por equipo: un solo contexto (últimos 5 en su liga); lo que falta no se dibuja.
   Viven en el capítulo 1 (la sección team-context se eliminó para no repetir). */
const contextCards = side => {
  const data = probability?.context?.[side];
  if (!data) return [];
  const cards = [];
  if (data.recentSample === 0) cards.push({ icon: 'chart', label: 'Partidos jugados', value: '0', note: 'primer partido en su liga · sin muestra previa' });
  const standing = probability?.inputs?.standings?.[data.team];
  if (standing && standing.played > 0 && standing.position != null) cards.push({ icon: 'chart', label: storyTerm('standings').term, value: `${standing.position}º`, note: `${standing.played} partidos jugados en su liga` });
  if (data.player?.name) cards.push({ icon: 'star', label: 'Mejor jugador', value: data.player.name, note: [data.player.detail, data.player.source].filter(Boolean).join(' · ') });
  if (data.season?.gf != null) cards.push({ icon: 'ball', label: 'Goles de temporada', value: String(data.season.gf), note: `${data.season.played ?? '—'} partidos · puesto ${data.season.position ?? '—'}${data.season.ga != null ? ` · ${data.season.ga} en contra` : ''}` });
  if (data.cleanSheets) cards.push({ icon: 'shield', label: storyTerm('cleanSheet').term, value: String(data.cleanSheets.value), note: `en los últimos ${data.cleanSheets.sample} partidos registrados` });
  if (data.unbeaten?.value) cards.push({ icon: 'bolt', label: 'Racha sin perder', value: `${data.unbeaten.value}`, note: 'partidos seguidos en la muestra reciente' });
  if (data.biggestWin) cards.push({ icon: 'target', label: 'Mayor diferencia', value: `+${data.biggestWin.value}`, note: `en los últimos ${data.biggestWin.sample} partidos` });
  return cards.slice(0, 5);
};
const cardsBySide = { home: contextCards('home'), away: contextCards('away') };
/* Migajas del fallback del fallback: solo datos reales que la columna de
   notas no muestra ya (competición·fecha, tabla rescatada por teamId,
   goleador si no tiene tarjeta). */
const fechaN = roundFecha(match.round);
const crumbsFor = side => {
  const name = side === 'home' ? match.home : match.away;
  const teamId = match.teamIds?.[side] ?? null;
  const labels = new Set(cardsBySide[side].map(card => card.label));
  const crumbs = [];
  if (fechaN != null && competition) crumbs.push(`${competition} · Fecha ${fechaN}`);
  const row = findStandingRow(standingsData, match.competition, { teamId, names: [name] });
  if (row && !labels.has(storyTerm('standings').term)) crumbs.push(`${row.position}.º · ${row.played} ${row.played === 1 ? 'partido' : 'partidos'}`);
  const scorer = topScorerFor(scorersData, match.competition, { teamId, names: [name] });
  const contextName = probability?.context?.[side]?.player?.name ?? null;
  if (scorer && scorer.matches != null && scorer.player !== contextName && !labels.has('Mejor jugador')) crumbs.push(`Goleador: ${scorer.player} · ${scorer.value} en ${scorer.matches}`);
  return crumbs;
};
---
<Layout title={`${homeEs} vs. ${awayEs} — GoatLab`} canonical={`/partido/${match.webId ?? match.id}/`}>
<main id="main" class="wrap">
 <a class="back-link" href="/#encuentros"><Icon size={16}/> Volver a encuentros</a>
 <div class="match-title"><div><h1>{homeEs}<span>vs.</span>{awayEs}</h1><p>{competition} · Última consulta: <time data-consult data-utc={fixtures.updatedAt}>{consultUtc}</time>{statusLabel === 'En juego' && match.minute != null ? ` · Minuto ${match.minute}` : ''}</p></div><span class="outline-label">{statusLabel}</span></div>
  <section class="real-data"><div class="encounter">
   <h2>El encuentro</h2>
   <p><time datetime={match.kickoff}>{new Date(match.kickoff).toLocaleString('es-PE',{timeZone:'America/Lima'})}</time> (Lima)</p>
    <p class={`encounter-score${match.homeScore == null ? ' is-waiting' : ''}`}>{match.homeScore == null || match.awayScore == null ? (match.status === 'NS' ? 'Por disputarse' : '— – —') : `${match.homeScore} – ${match.awayScore}`}</p>
   <div class="encounter-venue">
    <figure class="venue-zoom">
     <div class="venue-frame">
       <img src={venueMap.src} width={venueMap.width} height={venueMap.height} loading="lazy" decoding="async" alt={located ? `Recorte de mapa alrededor de ${location.city}` : `Mapa de ${fallback.label}; la sede no tiene ubicación confirmada`}/>
       {venuePin && <span class="venue-pin" style={`--x:${venuePin.x}%;--y:${venuePin.y}%`} aria-hidden="true">
       <svg class="venue-drop" viewBox="0 0 26 38"><path d="M13 1C6.4 1 1 6.4 1 13c0 8.6 12 24 12 24s12-15.4 12-24C25 6.4 19.6 1 13 1Z"/></svg>
       <span class="venue-pin-mark"><svg viewBox="0 0 40 40"><path d="M10 10v20h22M16 25v-8m7 8V11m7 14V15" fill="none" stroke="currentColor" stroke-width="3"/></svg></span>
      </span>}
     </div>
      <figcaption>{venueCaption}</figcaption>
     </figure>
    </div>
   </div><div>
    <div class="jerseys" aria-label={`Camisetas estimadas de ${homeEs} y ${awayEs}`}>
      <TeamJersey name={match.home} short={teamCompact(match.home)} pattern={homeKit.pattern} side="home"/>
      <span class="jerseys-vs" aria-hidden="true">vs</span>
       <TeamJersey name={match.away} short={teamCompact(match.away)} pattern={awayKit.pattern} side="away"/>
     </div>
   </div></section>
 <AdSlot variant="rect" slotKey="partidoPrevio"/>
 <div class="story">
  <div class="story-notes">
   <section class="story-chapter" id="llegada" data-chapter="llegada"><h2>Así llegan.<br/>Lo que ya jugaron.</h2><p>Lo único que nadie discute es lo que ya pasó en la cancha. Estos son los hechos: goles reales, medidos con la misma vara para los dos.</p>{recentMax > 0 && <div class="legend"><span><i class="home-dot"></i>{homeEs}</span><span><i class="away-dot"></i>{awayEs}</span></div>}{recentMax > 0 && <table class="data-table"><caption class="sr-only">Resumen de forma reciente con resultados reales</caption><thead><tr><th>{`Últimos ${recentMax} · reales`}</th><th>{teamShort(match.home)}</th><th>{teamShort(match.away)}</th></tr></thead><tbody><tr><td>Goles anotados</td><td>{tableHome ? homeTotals : '—'}</td><td>{tableAway ? awayTotals : '—'}</td></tr><tr><td>Promedio por partido</td><td>{recentAvg(homeTotals, tableHome)}</td><td>{recentAvg(awayTotals, tableAway)}</td></tr><tr><td>Victorias</td><td>{tableHome ? homeWins : '—'}</td><td>{tableAway ? awayWins : '—'}</td></tr></tbody></table>}{probability?.context && <div class="signal-panels"><p class="signals-lead">Últimos 5 en su campeonato:</p>{(['home','away'] as const).map(side => <article class="team-panel" data-side={side}><header><h3>{side === 'home' ? homeEs : awayEs}</h3><span class="outline-label">{side === 'home' ? 'Local' : 'Visitante'}</span></header>{cardsBySide[side].length ? <ul class="context-list">{cardsBySide[side].map(card => <li><span class="context-icon"><Icon name={card.icon} size={18}/></span><div><strong>{card.value}</strong><span class="context-label">{card.label}</span>{card.note && <small>{card.note}</small>}</div></li>)}</ul> : <p class="chapter-note">Sin datos suficientes de este equipo por ahora.</p>}</article>)}</div>}</section>
      {true && <section class="story-chapter" id="resultado" data-chapter="resultado"><h2>Escenarios de resultado.<br/>Distribución en 100 escenarios.</h2><p>{waffleSource ? `Estimación ${waffleSource}: reparte 100 escenarios simulados entre victoria local, empate y victoria visitante. No anticipa el resultado: es la distribución que estima el modelo con datos previos al partido.` : 'Sin lectura de proveedor para este encuentro por ahora.'}</p><div class="notes-visuals">
       <div class="prob-rows">
        {dcM && <ProbabilityBar variant="rows" title={storyTerm('doubleChance').term} segments={[{label: `${teamShort(match.home)} o empate`, value: dcM['1X'], tone: 'home'}, {label: `${teamShort(match.away)} o empate`, value: dcM.X2, tone: 'away'}]}/>}
        {dnbM && <ProbabilityBar variant="rows" title={storyTerm('dnb').term} segments={[{label: teamShort(match.home), value: dnbM.home, tone: 'home'}, {label: teamShort(match.away), value: dnbM.away, tone: 'away'}]}/>}
        {!dcM && <p class="chapter-note">Sin estimación de proveedor para local-o-empate / visita-o-empate por ahora.</p>}
      </div>
      </div></section>}
     {true && <section class="story-chapter" id="goles" data-chapter="goles"><h2>Goles totales.<br/>Distribución por umbrales.</h2><p>Probabilidad estimada de superar cada umbral, de que anoten ambos equipos y los marcadores más frecuentes en el cálculo.</p><div class="notes-visuals">
     <div class="prob-rows">
      {bttsM && <ProbabilityBar title="¿Marcan los dos?" segments={[{label: 'Sí', value: bttsM.yes, tone: 'home'}, {label: 'No', value: bttsM.no, tone: 'mute'}]}/>}
     </div>
     {(cleanM || exactTop.length > 0) && <ul class="prob-chips">
      {cleanM && <li><Icon name="shield" size={16}/><span>{storyTerm('cleanSheet').term} {teamShort(match.home)}</span><strong>{pct(cleanM.home)}</strong></li>}
      {cleanM && <li><Icon name="shield" size={16}/><span>{storyTerm('cleanSheet').term} {teamShort(match.away)}</span><strong>{pct(cleanM.away)}</strong></li>}
     </ul>}
      {exactTop.length > 0 && <ScorePodium title={storyTerm('exactScore').term} scores={exactTop} rest={exactRest.length ? `También aparecen: ${exactRest.map((score: any) => `${score.home}–${score.away} (${pct(score.p)})`).join(' · ')}` : null} summary={`Reparto entre los 5 marcadores más repetidos: ${exactTop.map((score: any) => `${score.home} a ${score.away} con ${pct(score.p)}`).join(', ')}`}/>}
      {(expectedScore || ceilingHome || ceilingAway || minTotal) && <ul class="prob-chips goal-facts">
       {expectedScore && <li><Icon name="target" size={16}/><span>Marcador final esperado</span><strong>{expectedScore}</strong></li>}
       {(ceilingHome || ceilingAway) && <li><Icon name="shield" size={16}/><span>Techos por equipo</span><strong>{teamShort(match.home)} {ceilingHome ?? '—'} · {teamShort(match.away)} {ceilingAway ?? '—'}</strong></li>}
       {minTotal && <li><Icon name="chart" size={16}/><span>Mínimo goles total</span><strong>{minTotal}</strong></li>}
