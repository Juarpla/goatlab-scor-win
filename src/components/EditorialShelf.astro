---
import { env } from 'cloudflare:workers';
import { listEditorials } from '../lib/editorial-store.js';
import EditorialCards from './EditorialCards.astro';
import Icon from './Icon.astro';
import { EDITORIAL_ROOT } from '../lib/editorial.js';
import '../styles/editorial.css';

let articles = [];
try {
  articles = (await listEditorials(env.GOATLAB_DB)).slice(0, 2);
} catch (error) {
  console.error('Editorial preview unavailable', error);
}
---
{articles.length > 0 && <section class="editorial-shelf" aria-labelledby="editorial-shelf-title">
  <div class="editorial-shelf-heading">
    <h2 id="editorial-shelf-title">Datos jugados.</h2>
    <a href={EDITORIAL_ROOT}>Todos los artículos <Icon size={16}/></a>
  </div>
  <EditorialCards articles={articles}/>
</section>}
