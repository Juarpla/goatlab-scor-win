---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FormStrip from '../../components/FormStrip.astro';
import Comparison from '../../components/Comparison.astro';
import AdSlot from '../../components/AdSlot.astro';
import TeamJersey from '../../components/TeamJersey.astro';
import PitchScene from '../../components/PitchScene.astro';
import ProbabilityBar from '../../components/ProbabilityBar.astro';
import ExtraMarkets from '../../components/ExtraMarkets.astro';
import WaffleResult from '../../components/WaffleResult.astro';
import GoalsLadder from '../../components/GoalsLadder.astro';
import ScorePodium from '../../components/ScorePodium.astro';
import RadarDuel from '../../components/RadarDuel.astro';
import TrendsStrip from '../../components/TrendsStrip.astro';
import { storyTerm } from '../../lib/story-dictionary.js';
import { competitions, FINISHED_STATUSES } from '../../lib/football.js';
import { teamShort } from '../../lib/teams.js';
import { teamForm, bakedForm } from '../../lib/form.js';
import { roundFecha, findStandingRow, topScorerFor } from '../../lib/series-crumbs.js';
import { hasH2HHistory } from '../../lib/bzzoiro.js';
import { ensemble } from '../../lib/predictions.js';
import { locateMatch } from '../../lib/venues.js';
import { teamColors } from '../../lib/team-colors.js';
import fixtures from '../../../public/data/fixtures.json';
import analyses from '../../../public/data/llm-analysis.json';
import results from '../../../public/data/results.json';
import standingsData from '../../../public/data/standings.json';
import scorersData from '../../../public/data/scorers.json';
import history from '../../../public/data/history-stats.json';
import evaluation from '../../../public/data/evaluation-report.json';
import '../../styles/partido.css';

export function getStaticPaths(){return fixtures.matches.map(match=>({params:{id:match.id},props:{match}}));}
const {match} = Astro.props;
const competition = competitions.find(c=>c.id===match.competition)?.name;
const homeForm = teamForm(results.results, match.home);
const awayForm = teamForm(results.results, match.away);
/* Lo que ya jugaron: horneado del pipeline primero, base local después; sin mínimo de muestra. */
const homeRecent = bakedForm(match.lastMatches?.home, match.home) ?? teamForm(results.results, match.home);
const awayRecent = bakedForm(match.lastMatches?.away, match.away) ?? teamForm(results.results, match.away);
const hasRecent = Boolean(homeRecent?.played || awayRecent?.played);
/* Cara a cara: con al menos 3 cruces registrados el capítulo muestra esos cruces; si no, el fallback de arriba. */
const h2hReady = hasH2HHistory(match.h2h);
const h2hHomeRecent = h2hReady ? bakedForm(match.h2h.recent, match.home) : null;
const h2hAwayRecent = h2hReady ? bakedForm(match.h2h.recent, match.away) : null;
const showH2H = Boolean(h2hHomeRecent && h2hAwayRecent);
const tableHome = showH2H ? h2hHomeRecent : homeRecent;
const tableAway = showH2H ? h2hAwayRecent : awayRecent;
const events = match.events;
const finished = FINISHED_STATUSES.has(match.status);
const statusLabel = finished ? 'Finalizado' : match.status === 'NS' ? 'Programado' : 'En juego';
type AiSection = { title: string; bullets: string[] };
type AiLimit = { label: string; detail: string };
const ai = (analyses as Record<string,{summary:string|AiSection[];limitations:string|AiLimit[]} | undefined>)[match.id];
/* La lectura (secciones) con fallback a párrafo legacy: vive entre los dos anuncios del cierre. */
const aiSections = Array.isArray(ai?.summary)
  ? ai.summary.filter(s => s && typeof s.title === 'string' && Array.isArray(s.bullets))
  : typeof ai?.summary === 'string' && ai.summary.trim() ? [{ title: '', bullets: [ai.summary] }] : [];
const aiLimits = Array.isArray(ai?.limitations)
  ? ai.limitations.filter(l => l && typeof l.label === 'string' && typeof l.detail === 'string')
  : typeof ai?.limitations === 'string' && ai.limitations.trim() ? [{ label: 'Nota', detail: ai.limitations }] : [];
const EVENT_LABELS = { goal: 'Gol', card: 'Tarjeta', sub: 'Cambio' };
/* Tabla del pronóstico: valores esperados con coma latina; lo nulo se pinta '—'. */
const count1 = v => v == null ? '—' : Number(v).toFixed(1).replace('.', ',');
const FORECAST_ROWS = [
  ['Posesión', 'possession', v => v == null ? '—' : `${Math.round(v)}%`],
  ['Tiros', 'shots', count1],
  ['Tiros a puerta', 'shotsOnTarget', count1],
  ['Goles esperados (xG)', 'xg', v => v == null ? '—' : Number(v).toFixed(2).replace('.', ',')],
  ['Córners', 'corners', count1],
  ['Faltas', 'fouls', count1],
  ['Tarjetas amarillas', 'yellowCards', count1],
  ['Tarjetas rojas', 'redCards', count1],
  ['Fueras de juego', 'offsides', count1],
];
const forecastCell = (side, row) => {
  const [label, key, format] = row;
  const value = side?.[key];
  return format ? format(value) : value ?? '—';
};
const homeTotals = tableHome ? tableHome.goalsFor.reduce((a:number,b:number)=>a+b,0) : 0;
const awayTotals = tableAway ? tableAway.goalsFor.reduce((a:number,b:number)=>a+b,0) : 0;
const homeWins = tableHome ? tableHome.form.filter((x:string)=>x==='G').length : 0;
const awayWins = tableAway ? tableAway.form.filter((x:string)=>x==='G').length : 0;
const recentMax = Math.max(tableHome?.played ?? 0, tableAway?.played ?? 0);
const recentAvg = (totals:number, recent) => recent ? (totals/recent.played).toFixed(1) : '—';

/* Cabecera: última consulta con la hora del paso de datos; el cliente la reescribe al huso del visitante. */
const consultUtc = fixtures.updatedAt ? `${fixtures.updatedAt.slice(0,10)} ${fixtures.updatedAt.slice(11,16)} UTC` : '—';

/* Sede y zoom del estadio: si el club no está en el catálogo, el bloque se omite. */
const location = locateMatch(match);

/* Probabilidades horneadas por el pipeline (un JSON por partido, revisable a mano). */
const probabilityFiles = import.meta.glob('../../../public/match-probabilities/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const probability: any = probabilityFiles[`../../../public/match-probabilities/${match.id}.json`] ?? null;
/* Tendencias: hechos locales + extra del pipeline (retransmisiones/social); sin archivo, solo local. */
const trendsFiles = import.meta.glob('../../../public/data/trends-extra.json', { eager: true, import: 'default' }) as Record<string, any>;
const trendsExtra: any = (Object.values(trendsFiles)[0] as any)?.[match.id] ?? null;
const markets = probability?.markets ?? null;
const race = probability?.firstGoal ?? null;
const scorerRows = probability?.scorers ?? null;
const pct = (value: number | null | undefined) => value == null ? '—' : `${Math.round(value * 100)}%`;
/* Decimales en coma latina para las lecturas nuevas (goles esperados). */
const dec = (value: number | null | undefined, digits = 1) => value == null ? '—' : Number(value).toFixed(digits).replace('.', ',');
const bandMax = race ? Math.max(...race.bands.map((band: any) => band.p)) : 0;
const firstSplit = race && (race.firstHome + race.firstAway) > 0 ? race.firstHome / (race.firstHome + race.firstAway) : 0.5;
const exactAll = markets?.exactScores ?? [];
const exactTop = exactAll.slice(0, 3);
const exactRest = exactAll.slice(3);
const homeKit = teamColors(match.home);
const awayKit = teamColors(match.away);

/* Capítulos dinámicos: el esqueleto (llegada + veredicto) siempre está;
   resultado, goles y primer gol solo aparecen con datos en el JSON. */
const lambdas = probability?.inputs?.lambdas ?? null;
const sampleN = probability?.inputs?.sample ?? null;
const hasMarkets = Boolean(markets?.oneX2);
const totals = markets?.totals ?? null;
const bttsM = markets?.btts ?? null;
const cleanM = markets?.cleanSheet ?? null;
const dnbM = markets?.dnb ?? null;
const dcM = markets?.doubleChance ?? null;
const prov = probability?.provider ?? null;
const provFav = prov?.predicted === 'H' ? match.home : prov?.predicted === 'A' ? match.away : prov?.predicted === 'D' ? 'el empate' : null;
const provResultBits = [
  prov?.score ? `marcador ${prov.score}` : null,
  provFav ? `favorito: ${provFav}` : null,
  prov?.confidence != null ? `confianza ${Math.round(prov.confidence * 100)}%` : null,
].filter(Boolean);
const provGoalsBits = [
  prov?.xg ? `goles esperados ${dec(prov.xg.home, 2)}–${dec(prov.xg.away, 2)}` : null,
  prov?.over25 != null ? `más de 2.5: ${pct(prov.over25)}` : null,
  prov?.btts != null ? `marcan los dos: ${pct(prov.btts)}` : null,
  prov?.cornersOver95 != null ? `más de 9.5 córners: ${pct(prov.cornersOver95)}` : null,
].filter(Boolean);
const hasScorerData = Boolean(scorerRows && (scorerRows.home?.length || scorerRows.away?.length));
const hasFirst = Boolean(race || hasScorerData);
const ladder = totals ? [
  { line: '1.5', over: totals.over15, under: totals.under15 },
  { line: '2.5', over: totals.over25, under: totals.under25 },
  { line: '3.5', over: totals.over35, under: totals.under35 },
] : [];
const waffle = hasMarkets ? [
  { label: teamShort(match.home), value: markets.oneX2.home, tone: 'home' as const },
  { label: 'Empate', value: markets.oneX2.draw, tone: 'draw' as const },
  { label: teamShort(match.away), value: markets.oneX2.away, tone: 'away' as const },
] : [];
const fmtLambda = (value: number | null | undefined) => value == null ? '—' : `~${dec(value)}`;
const methodLabel = typeof probability?.method === 'string' && probability.method.includes('dixon')
  ? 'Modelo Poisson con corrección de empates (Dixon-Coles)'
  : 'Modelo Poisson de GoatLab';

/* Números pronosticados: valores esperados siempre con muestra; duelos en
   porcentaje solo cuando su insumo supera la evaluación histórica. */
const forecast = probability?.statsForecast ?? null;
const dominance = probability?.dominance ?? null;
const hasForecast = Boolean(forecast && (forecast.home || forecast.away));
const statEval = evaluation?.stats?.metrics ?? {};
const statOk = (key: string) => statEval[key]?.published === true;
const cornersOk = hasForecast && statOk('corners');
const cornersDuel = cornersOk ? dominance?.cornersDuel ?? null : null;
const cornerRace = cornersOk ? dominance?.cornerRace ?? null : null;
const cornerMargin = cornersOk ? dominance?.cornerMargin ?? null : null;
const cardsDuel = hasForecast && statOk('yellowCards') ? dominance?.cardsDuel ?? null : null;
const lastTrio = hasForecast && evaluation?.gate?.poissonOk ? dominance?.lastGoal ?? null : null;
/* Reparto 0–1 entre ambos para el radar; nulo cuando falta un lado. */
const share = (home: number | null | undefined, away: number | null | undefined) =>
  home != null && away != null && home + away > 0 ? home / (home + away) : null;
const mkAxis = (label: string, home: number | null | undefined, away: number | null | undefined) => {
  const s = share(home, away);
  return s == null ? null : { label, home: s, away: 1 - s };
};
/* El radar dibuja solo ejes ofensivos con evaluación publicada. */
const duelAxes = hasForecast ? [
  statOk('corners') ? mkAxis('Córners', forecast.home.corners, forecast.away.corners) : null,
  statOk('shots') ? mkAxis('Tiros', forecast.home.shots, forecast.away.shots) : null,
  statOk('shotsOnTarget') ? mkAxis('A puerta', forecast.home.shotsOnTarget, forecast.away.shotsOnTarget) : null,
  statOk('xg') ? mkAxis('xG', forecast.home.xg, forecast.away.xg) : null,
].filter(Boolean) : [];
const raceTargets = [3, 5, 7].filter(target => cornerRace?.[target]?.home != null);
const marginBands = cornerMargin ? [
  { label: `${teamShort(match.home)} por 3 o más`, value: cornerMargin.home3plus, tone: 'home' as const },
  { label: `${teamShort(match.home)} por 1–2`, value: cornerMargin.home12, tone: 'home' as const },
  { label: 'Iguales', value: cornerMargin.level, tone: 'draw' as const },
  { label: `${teamShort(match.away)} por 1–2`, value: cornerMargin.away12, tone: 'away' as const },
  { label: `${teamShort(match.away)} por 3 o más`, value: cornerMargin.away3plus, tone: 'away' as const },
] : [];
const forecastSample = forecast ? `con ${forecast.sample.home} y ${forecast.sample.away} partidos analizados` : '';

/* Veredicto GoatLab: insumos calculados al construir la página; porcentajes solo si la evaluación histórica pasa. */
const absentCount = side => (match.lineups?.unavailablePlayers ?? []).filter(player => player.team === side).length;
const unavailable = match.lineups?.unavailablePlayers?.length ? { home: absentCount('home'), away: absentCount('away') } : null;
const verdict = ensemble({ results: results.results, history: history.rows, h2h: match.h2h ?? null, catboost: match.modelPrediction ?? null, home: match.home, away: match.away, homeForm, awayForm, unavailable });
const published = Boolean(evaluation?.published) && Boolean(verdict);
const direction = verdict ? (verdict.oneX2.home >= verdict.oneX2.draw && verdict.oneX2.home >= verdict.oneX2.away ? match.home : verdict.oneX2.away > verdict.oneX2.draw ? match.away : null) : null;
const marketsList = verdict ? [
  { label: 'Más de 2.5 goles', value: verdict.over25 },
  { label: 'Ambos equipos anotan', value: verdict.btts },
] : [];

/* Tarjetas por equipo: cada dato declara su muestra; lo que falta no se dibuja.
   Viven en el capítulo 1 (la sección team-context se eliminó para no repetir). */
const contextCards = side => {
  const data = probability?.context?.[side];
  if (!data) return [];
  const cards = [];
  const standing = probability?.inputs?.standings?.[data.team];
  if (standing && standing.played > 0 && standing.position != null) cards.push({ icon: 'chart', label: storyTerm('standings').term, value: `${standing.position}º`, note: `${standing.played} partidos jugados en su liga` });
  if (data.player?.name) cards.push({ icon: 'star', label: 'Mejor jugador', value: data.player.name, note: [data.player.detail, data.player.source].filter(Boolean).join(' · ') });
  if (data.season?.gf != null) cards.push({ icon: 'ball', label: 'Goles de temporada', value: String(data.season.gf), note: `${data.season.played ?? '—'} partidos · puesto ${data.season.position ?? '—'}${data.season.ga != null ? ` · ${data.season.ga} en contra` : ''}` });
  if (data.cleanSheets) cards.push({ icon: 'shield', label: storyTerm('cleanSheet').term, value: String(data.cleanSheets.value), note: `en los últimos ${data.cleanSheets.sample} partidos registrados` });
  if (data.unbeaten?.value) cards.push({ icon: 'bolt', label: 'Racha sin perder', value: `${data.unbeaten.value}`, note: 'partidos seguidos en la muestra reciente' });
  if (data.biggestWin) cards.push({ icon: 'target', label: 'Mayor diferencia', value: `+${data.biggestWin.value}`, note: `en los últimos ${data.biggestWin.sample} partidos` });
  return cards.slice(0, 5);
};
const cardsBySide = { home: contextCards('home'), away: contextCards('away') };
/* Migajas del fallback del fallback: solo datos reales que la columna de
   notas no muestra ya (competición·fecha, tabla rescatada por teamId,
   sede si el bloque de mapa se omite, goleador si no tiene tarjeta). */
const fechaN = roundFecha(match.round);
const crumbsFor = side => {
  const name = side === 'home' ? match.home : match.away;
  const teamId = match.teamIds?.[side] ?? null;
  const labels = new Set(cardsBySide[side].map(card => card.label));
  const crumbs = [];
  if (fechaN != null && competition) crumbs.push(`${competition} · Fecha ${fechaN}`);
  const row = findStandingRow(standingsData, match.competition, { teamId, names: [name] });
  if (row && !labels.has(storyTerm('standings').term)) crumbs.push(`${row.position}.º · ${row.played} ${row.played === 1 ? 'partido' : 'partidos'}`);
  if (!location && match.venue) crumbs.push([match.venue, match.venueCity].filter(Boolean).join(' · '));
  const scorer = topScorerFor(scorersData, match.competition, { teamId, names: [name] });
  const contextName = probability?.context?.[side]?.player?.name ?? null;
  if (scorer && scorer.matches != null && scorer.player !== contextName && !labels.has('Mejor jugador')) crumbs.push(`Goleador: ${scorer.player} · ${scorer.value} en ${scorer.matches}`);
  return crumbs;
};
---
<Layout title={`${match.home} vs. ${match.away} — GoatLab`}>
<main id="main" class="wrap">
 <a class="back-link" href="/#encuentros"><Icon size={16}/> Volver a encuentros</a>
 <div class="match-title"><div><h1>{match.home}<span>vs.</span>{match.away}</h1><p>{competition} · Última consulta: <time data-consult data-utc={fixtures.updatedAt}>{consultUtc}</time>{statusLabel === 'En juego' && match.minute != null ? ` · Minuto ${match.minute}` : ''}</p></div><span class="outline-label">{statusLabel}</span></div>
 <section class="real-data"><div class="encounter">
   <div class="encounter-head">
    <div>
     <h2>El encuentro</h2>
     <p><time datetime={match.kickoff}>{new Date(match.kickoff).toLocaleString('es-PE',{timeZone:'America/Lima'})}</time> (Lima)</p>
     <p class={`encounter-score${match.homeScore == null ? ' is-waiting' : ''}`}>{match.homeScore ?? '—'} – {match.awayScore ?? '—'}</p>
    </div>
    <div class="jerseys" aria-label={`Camisetas estimadas de ${match.home} y ${match.away}`}>
     <TeamJersey name={match.home} short={teamShort(match.home)} pattern={homeKit.pattern} side="home"/>
     <span class="jerseys-vs" aria-hidden="true">vs</span>
     <TeamJersey name={match.away} short={teamShort(match.away)} pattern={awayKit.pattern} side="away"/>
    </div>
   </div>
   {location?.zoom && <figure class="venue-zoom">
    <div class="venue-frame">
     <img src={location.zoom.src} width={location.zoom.width} height={location.zoom.height} loading="lazy" decoding="async" alt={`Recorte de mapa alrededor de ${location.city}`}/>
     <span class="venue-pin" style={`--x:${location.zoom.pinX}%;--y:${location.zoom.pinY}%`} aria-hidden="true">
      <svg class="venue-drop" viewBox="0 0 26 38"><path d="M13 1C6.4 1 1 6.4 1 13c0 8.6 12 24 12 24s12-15.4 12-24C25 6.4 19.6 1 13 1Z"/></svg>
      <span class="venue-pin-mark"><svg viewBox="0 0 40 40"><path d="M10 10v20h22M16 25v-8m7 8V11m7 14V15" fill="none" stroke="currentColor" stroke-width="3"/></svg></span>
     </span>
    </div>
    <figcaption>{location.stadium ?? location.city} · {location.city}, {location.country}</figcaption>
   </figure>}
  </div><div>
   <p>{fixtures.delayed?'Fuente con retraso':'Datos actualizados periódicamente'}. Última consulta: <time data-consult data-utc={fixtures.updatedAt}>{consultUtc}</time>.</p>
   <p>Todas las cifras provienen de proveedores deportivos. No se sustituyen por datos de ejemplo.</p>
  </div></section>
 <AdSlot variant="rect" slotKey="partidoPrevio"/>
 <div class="story">
  <div class="story-notes">
   <section class="story-chapter" id="llegada" data-chapter="llegada"><h2>Así llegan.<br/>Lo que ya jugaron.</h2><p>Lo único que nadie discute es lo que ya pasó en la cancha. Estos son los hechos: goles reales, medidos con la misma vara para los dos.</p>{recentMax > 0 && <div class="legend"><span><i class="home-dot"></i>{match.home}</span><span><i class="away-dot"></i>{match.away}</span></div>}{recentMax > 0 && <table class="data-table"><caption class="sr-only">Resumen de forma reciente con resultados reales</caption><thead><tr><th>{showH2H ? `Últimos ${recentMax} cruces · reales` : `Últimos ${recentMax} · reales`}</th><th>{teamShort(match.home)}</th><th>{teamShort(match.away)}</th></tr></thead><tbody><tr><td>Goles anotados</td><td>{tableHome ? homeTotals : '—'}</td><td>{tableAway ? awayTotals : '—'}</td></tr><tr><td>Promedio por partido</td><td>{recentAvg(homeTotals, tableHome)}</td><td>{recentAvg(awayTotals, tableAway)}</td></tr><tr><td>Victorias</td><td>{tableHome ? homeWins : '—'}</td><td>{tableAway ? awayWins : '—'}</td></tr></tbody></table>}{probability?.context && <div class="signal-panels"><p class="signals-lead">De encuentros previos en su campeonato:</p>{(['home','away'] as const).map(side => <article class="team-panel" data-side={side}><header><h3>{side === 'home' ? match.home : match.away}</h3><span class="outline-label">{side === 'home' ? 'Local' : 'Visitante'}</span></header>{cardsBySide[side].length ? <ul class="context-list">{cardsBySide[side].map(card => <li><span class="context-icon"><Icon name={card.icon} size={18}/></span><div><strong>{card.value}</strong><span class="context-label">{card.label}</span>{card.note && <small>{card.note}</small>}</div></li>)}</ul> : <p class="chapter-note">Sin datos suficientes de este equipo por ahora.</p>}</article>)}</div>}<details class="meaning"><summary>¿Qué significa esto?</summary><p><strong>{storyTerm('form').term}.</strong> {storyTerm('form').hint}</p><p><strong>{storyTerm('standings').term}.</strong> {storyTerm('standings').hint}</p></details><span class="chapter-note">{recentMax > 0 ?'Una muestra corta permite comparar la forma reciente; no demuestra lo que ocurrirá en el siguiente partido.':'Todavía no hay suficientes resultados registrados para comparar la forma de estos equipos.'}</span></section>
    {hasForecast && <section class="story-chapter" id="estadisticas" data-chapter="estadisticas"><h2>El partido,<br/>en números.</h2><p>{storyTerm('forecast').term}: posesión, tiros, córners, faltas y tarjetas que espera el cálculo para cada equipo. No es el acta del partido: es lo pronosticado, para que cada lector saque sus cuentas.</p><div class="legend"><span><i class="home-dot"></i>{match.home}</span><span><i class="away-dot"></i>{match.away}</span></div><table class="data-table"><caption class="sr-only">Valores esperados por equipo</caption><thead><tr><th>Esperados · pronóstico</th><th>{teamShort(match.home)}</th><th>{teamShort(match.away)}</th></tr></thead><tbody>{FORECAST_ROWS.map(row=><tr><td>{row[0]}</td><td>{forecastCell(forecast.home,row)}</td><td>{forecastCell(forecast.away,row)}</td></tr>)}</tbody></table><details class="meaning"><summary>¿Qué significa esto?</summary><p><strong>{storyTerm('forecast').term}.</strong> {storyTerm('forecast').hint}</p><p><strong>{storyTerm('dominance').term}.</strong> {storyTerm('dominance').hint}</p></details><span class="chapter-note">Modelo de ritmos de GoatLab ({forecast.method}), {forecastSample}. Las métricas sin muestra o sin evaluación se omiten. Son estimaciones estadísticas, no cuotas ni consejos.</span><a class="text-link" href="/metodologia/">Cómo se calcula y se evalúa <Icon size={18}/></a></section>}
    {hasMarkets && <section class="story-chapter" id="resultado" data-chapter="resultado"><h2>Quién se lo lleva.<br/>El resultado, en 100 partidos.</h2><p>El cálculo reparte 100 partidos imaginarios entre los tres resultados. No es una promesa: es cómo salen las cuentas con la muestra declarada.</p><details class="meaning"><summary>¿Qué significa esto?</summary><p><strong>{storyTerm('oneX2').term}.</strong> {storyTerm('oneX2').hint}</p><p><strong>{storyTerm('doubleChance').term}.</strong> {storyTerm('doubleChance').hint}</p><p><strong>{storyTerm('dnb').term}.</strong> {storyTerm('dnb').hint}</p><p><strong>{storyTerm('lambdas').term}.</strong> {storyTerm('lambdas').hint}</p></details><span class="chapter-note">{methodLabel}{sampleN ? `, con ${sampleN.home} y ${sampleN.away} partidos analizados` : ''}. Son estimaciones estadísticas de GoatLab, no cuotas ni consejos: aquí no hay unidades de apuesta, solo probabilidad.</span></section>}
    {hasMarkets && <section class="story-chapter" id="goles" data-chapter="goles"><h2>Cuántos goles.<br/>El partido, en el marcador.</h2><p>¿Fiesta o candado? La escalera del total, si marcan los dos equipos y los marcadores que más repite el cálculo.</p><details class="meaning"><summary>¿Qué significa esto?</summary><p><strong>{storyTerm('overUnder').term}.</strong> {storyTerm('overUnder').hint}</p><p><strong>{storyTerm('btts').term}.</strong> {storyTerm('btts').hint}</p><p><strong>{storyTerm('cleanSheet').term}.</strong> {storyTerm('cleanSheet').hint}</p><p><strong>{storyTerm('exactScore').term}.</strong> {storyTerm('exactScore').hint}</p></details><span class="chapter-note">Cada peldaño se lee por separado: que sea probable pasar de 1.5 no dice nada de llegar a 3.5.</span></section>}
    {hasFirst && <section class="story-chapter" id="primer-gol" data-chapter="primer-gol"><h2>El primer gol.<br/>Cuándo cae y quién lo mete.</h2><p>La espera del primer gol, tramo a tramo, y los nombres que suelen abrirlo en cada equipo.</p><details class="meaning"><summary>¿Qué significa esto?</summary><p><strong>{storyTerm('firstGoal').term}.</strong> {storyTerm('firstGoal').hint}</p><p><strong>{storyTerm('anytime').term}.</strong> {storyTerm('anytime').hint}</p><p><strong>{storyTerm('firstScorer').term}.</strong> {storyTerm('firstScorer').hint}</p><p><strong>{storyTerm('share').term}.</strong> {storyTerm('share').hint}</p></details><span class="chapter-note">Los goleadores llegan de la lista de la temporada que entrega el proveedor; si un equipo no la publica, su columna no aparece.</span></section>}
    <section class="story-chapter" id="veredicto" data-chapter="veredicto"><h2>El veredicto.<br/>Con sus pesos a la vista.</h2><p>GoatLab combina sus propios cálculos con el modelo del proveedor y señales de rendimiento. Cada insumo declara su peso; lo que falta, se dice.</p>{verdict && <table class="data-table"><caption class="sr-only">Insumos del veredicto y su peso</caption><thead><tr><th>Insumo</th><th>Peso</th></tr></thead><tbody>{verdict.inputs.map(input=><tr><td><strong>{input.label}</strong>{input.detail && <><br/><small>{input.detail}</small></>}</td><td>{input.weight > 0 ? <span class="weight-bar"><i style={`--w:${input.weight * 100}%`}></i>{Math.round(input.weight * 100)}%</span> : '—'}</td></tr>)}</tbody></table>}<span class="chapter-note">El veredicto es estimación estadística, no una cuota ni un consejo. Sus porcentajes se publican solo cuando la evaluación histórica supera a su baseline.</span><a class="text-link" href="/metodologia/">Cómo se calcula y se evalúa <Icon size={18}/></a></section>
  </div>
   <div class="story-stage"><div class="chapter-tabs" role="group" aria-label="Gráfico del análisis"><button data-stage="llegada" aria-pressed="true">Cómo llegan</button>{hasForecast && <button data-stage="estadisticas" aria-pressed="false">En números</button>}{hasMarkets && <button data-stage="resultado" aria-pressed="false">Quién se lo lleva</button>}{hasMarkets && <button data-stage="goles" aria-pressed="false">Cuántos goles</button>}{hasFirst && <button data-stage="primer-gol" aria-pressed="false">El primer gol</button>}<button data-stage="veredicto" aria-pressed="false">El veredicto</button></div>
    <div class="stage-pane is-active" data-pane="llegada" aria-hidden="false">{showH2H ? <><Comparison home={match.home} away={match.away} shortHome={teamShort(match.home)} shortAway={teamShort(match.away)} homeForm={h2hHomeRecent} awayForm={h2hAwayRecent}/><p class="chapter-note">Cruces entre ambos: {match.h2h.totalMatches} registrados; aquí los últimos {recentMax}.</p></> : hasRecent ? <FormStrip home={match.home} away={match.away} homeForm={homeRecent} awayForm={awayRecent} homeCrumbs={crumbsFor('home')} awayCrumbs={crumbsFor('away')}/> : <FormStrip home={match.home} away={match.away} homeForm={null} awayForm={null} homeCrumbs={crumbsFor('home')} awayCrumbs={crumbsFor('away')}/>}</div>
    {hasForecast && <div class="stage-pane" data-pane="estadisticas" aria-hidden="true" hidden>
     <h3>Frente a frente</h3>
     <RadarDuel axes={duelAxes} homeShort={teamShort(match.home)} awayShort={teamShort(match.away)} summary={`Dominancia esperada entre ${match.home} y ${match.away}: reparto de córners, tiros, tiros a puerta y goles esperados`}/>
     <div class="prob-rows">
      {cornersDuel && <ProbabilityBar title={storyTerm('cornersDuel').term} segments={[{label: teamShort(match.home), value: cornersDuel.home, tone: 'home'}, {label: 'Empate', value: cornersDuel.draw, tone: 'draw'}, {label: teamShort(match.away), value: cornersDuel.away, tone: 'away'}]}/>}
      {raceTargets.map(target => <ProbabilityBar title={`Primero a ${target} córners`} segments={[{label: teamShort(match.home), value: cornerRace[target].home, tone: 'home'}, {label: teamShort(match.away), value: cornerRace[target].away, tone: 'away'}]}/>)}
      {marginBands.length > 0 && <ProbabilityBar title={storyTerm('cornerMargin').term} segments={marginBands}/>}
      {cardsDuel && <ProbabilityBar title={storyTerm('cardsDuel').term} segments={[{label: teamShort(match.home), value: cardsDuel.home, tone: 'home'}, {label: 'Empate', value: cardsDuel.draw, tone: 'draw'}, {label: teamShort(match.away), value: cardsDuel.away, tone: 'away'}]}/>}
      {lastTrio && <ProbabilityBar title={storyTerm('lastGoalTeam').term} segments={[{label: teamShort(match.home), value: lastTrio.home, tone: 'home'}, {label: 'Se queda en cero', value: lastTrio.noGoal, tone: 'mute'}, {label: teamShort(match.away), value: lastTrio.away, tone: 'away'}]}/>}
     </div>
     {!cornersDuel && !cardsDuel && !lastTrio && <p class="chapter-note">Duelos en evaluación: los porcentajes aparecen cuando su insumo supera a su baseline histórico.</p>}
     {prov?.xg && <p class="second-reading">La otra lectura (Bzzoiro): goles esperados {dec(prov.xg.home, 2)}–{dec(prov.xg.away, 2)}.</p>}
     <span class="chapter-note">Duelos derivados de los ritmos con evaluación publicada; la carrera hereda la de los córners. No son cuotas ni consejos de apuesta.</span>
    </div>}
    {hasMarkets && <div class="stage-pane" data-pane="resultado" aria-hidden="true" hidden>
     <h3>Quién se lo lleva</h3>
     {lambdas && <div class="lambda-band">
      <p><strong>{storyTerm('lambdas').term}:</strong> {teamShort(match.home)} {fmtLambda(lambdas.home)} · {teamShort(match.away)} {fmtLambda(lambdas.away)}{sampleN ? <span> · {sampleN.home} y {sampleN.away} partidos analizados</span> : ''}</p>
      <div class="lambda-gauges">
       {[['home', match.home, lambdas.home], ['away', match.away, lambdas.away]].map(([side, name, value], index) => (
        <div class="lambda-row">
         <span class="lambda-name">{teamShort(name as string)}</span>
         <svg class="prob-row-track" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
          <rect class="prob-row-bg" x="0" y="0" width="100" height="6" rx="3"/>
          {(value as number) > 0 && <rect class={`prob-fill prob-${side} pt-grow-x`} style={`--d:${(index * 0.15).toFixed(2)}s`} x="0" y="0" width={Math.min(100, ((value as number) / 3) * 100)} height="6" rx="3"/>}
         </svg>
         <strong>{fmtLambda(value as number)}</strong>
        </div>
       ))}
      </div>
     </div>}
     <WaffleResult title="Si se jugara 100 veces…" segments={waffle} summary={`Reparto de 100 partidos imaginarios: ${match.home} ${Math.round(markets.oneX2.home * 100)}, empate ${Math.round(markets.oneX2.draw * 100)}, ${match.away} ${Math.round(markets.oneX2.away * 100)}`} note="Cada cuadrito es un partido imaginario con estos números."/>
     <div class="prob-rows">
      {dcM && <ProbabilityBar variant="rows" title={storyTerm('doubleChance').term} segments={[{label: `${teamShort(match.home)} o empate`, value: dcM['1X'], tone: 'home'}, {label: `${teamShort(match.away)} o empate`, value: dcM.X2, tone: 'away'}]} note={dnbM ? `${storyTerm('dnb').term}: ${teamShort(match.home)} ${pct(dnbM.home)} · ${teamShort(match.away)} ${pct(dnbM.away)}` : storyTerm('doubleChance').hint}/>}
     </div>
     {provResultBits.length > 0 && <p class="second-reading">La otra lectura (Bzzoiro): {provResultBits.join(' · ')}.</p>}
     <span class="chapter-note">Estimaciones del {methodLabel.toLowerCase()} con la muestra declarada arriba. No son cuotas ni consejos de apuesta.</span>
    </div>}
    {hasMarkets && <div class="stage-pane" data-pane="goles" aria-hidden="true" hidden>
     <h3>Cuántos goles</h3>
     {ladder.length > 0 && <GoalsLadder title="La escalera del total" rungs={ladder} summary={`Probabilidad de pasar cada línea: más de 1.5 el ${pct(totals.over15)}, más de 2.5 el ${pct(totals.over25)}, más de 3.5 el ${pct(totals.over35)}`}/>}
     <div class="prob-rows">
      {bttsM && <ProbabilityBar title="¿Marcan los dos?" segments={[{label: 'Sí', value: bttsM.yes, tone: 'home'}, {label: 'No', value: bttsM.no, tone: 'mute'}]}/>}
     </div>
     {(cleanM || exactTop.length > 0) && <ul class="prob-chips">
      {cleanM && <li><Icon name="shield" size={16}/><span>{storyTerm('cleanSheet').term} {teamShort(match.home)}</span><strong>{pct(cleanM.home)}</strong></li>}
      {cleanM && <li><Icon name="shield" size={16}/><span>{storyTerm('cleanSheet').term} {teamShort(match.away)}</span><strong>{pct(cleanM.away)}</strong></li>}
     </ul>}
     {exactTop.length > 0 && <ScorePodium title={storyTerm('exactScore').term} scores={exactTop} rest={exactRest.length ? `También aparecen: ${exactRest.map((score: any) => `${score.home}–${score.away} (${pct(score.p)})`).join(' · ')}` : null} summary={`Marcadores más probables: ${exactTop.map((score: any) => `${score.home} a ${score.away} con ${pct(score.p)}`).join(', ')}`}/>}
     {provGoalsBits.length > 0 && <p class="second-reading">La otra lectura (Bzzoiro): {provGoalsBits.join(' · ')}.</p>}
     <ExtraMarkets discipline={probability?.discipline} setPieces={probability?.setPieces} weatherVenue={probability?.weatherVenue} availability={probability?.availability} />
     <span class="chapter-note">Estimaciones del modelo Poisson de GoatLab con la forma reciente y los líderes de temporada como insumos. No son cuotas ni consejos de apuesta.</span>
    </div>}
    {hasFirst && <div class="stage-pane" data-pane="primer-gol" aria-hidden="true" hidden>
     <h3>El primer gol</h3>
     {race ? <figure class="prob-hero">
      <figcaption><span>¿Cuándo se abre el marcador?</span><small>Probabilidad de que el primer gol caiga en cada tramo de 15 minutos</small></figcaption>
      <svg viewBox="0 0 348 128" role="img" aria-label={`Probabilidad del primer gol por tramos; se queda en cero: ${pct(race.noGoal)}`}>
       <g class="race-grid" aria-hidden="true"><line x1="10" y1="100" x2="338" y2="100"/><line x1="10" y1="60" x2="338" y2="60"/><line x1="10" y1="20" x2="338" y2="20"/></g>
       {race.bands.map((band: any, index: number) => {
         const height = bandMax > 0 ? Math.max(2, (band.p / bandMax) * 74) : 0;
         const x = 16 + index * 54;
         const homeHeight = height * firstSplit;
         return <g class="race-bar">
          <rect class="race-home pt-grow" style={`--d:${(index * 0.1).toFixed(2)}s`} x={x} y={100 - homeHeight} width="42" height={homeHeight} rx="1.5"/>
          <rect class="race-away pt-grow" style={`--d:${(index * 0.1).toFixed(2)}s`} x={x} y={100 - height} width="42" height={height - homeHeight} rx="1.5"/>
          <text class="race-value" x={x + 21} y={100 - height - 6} text-anchor="middle">{Math.round(band.p * 100)}%</text>
          <text class="race-label" x={x + 21} y="115" text-anchor="middle">{band.from}–{band.to}′</text>
         </g>;
       })}
      </svg>
      <p class="race-foot"><span><i class="race-key race-key-home"></i>{teamShort(match.home)} {pct(race.firstHome)}</span><span><i class="race-key race-key-away"></i>{teamShort(match.away)} {pct(race.firstAway)}</span><span class="race-none">Se queda en cero: {pct(race.noGoal)}</span></p>
     </figure> : <><h3>La espera del primer gol</h3><p class="chapter-note">El cálculo de los tramos necesita la muestra completa; mientras tanto, los nombres que suelen abrirlo están abajo.</p></>}
     {hasScorerData && <div class="prob-scorers">
      {(['home','away'] as const).map(side => scorerRows[side]?.length ? <div class="scorer-column">
       <h4>{teamShort(side === 'home' ? match.home : match.away)} · {storyTerm('anytime').term.toLowerCase()}</h4>
       <ul>{scorerRows[side].map((row: any) => <li>
        <span class="scorer-name">{row.player}</span>
        <span class="scorer-bar" style={`--share:${row.anytime * 100}%`} aria-hidden="true"></span>
        <strong>{pct(row.anytime)}</strong>
        <small>{row.goals} {row.goals === 1 ? 'gol' : 'goles'} de temporada · {storyTerm('firstScorer').term.toLowerCase()} {pct(row.first)}</small>
       </li>)}</ul>
      </div> : null)}
      </div>}
     <span class="chapter-note">Tramos y goleadores estimados por el modelo de GoatLab. No son cuotas ni consejos de apuesta.</span>
    </div>}
    <div class="stage-pane" data-pane="veredicto" aria-hidden="true" hidden>{verdict ? <>
     <h3>El veredicto</h3>
     {published ? <>
      <div class="verdict-bars">
       {(['home','draw','away'] as const).map(side => <div class="verdict-row"><span class="verdict-label">{side === 'home' ? teamShort(match.home) : side === 'away' ? teamShort(match.away) : 'Empate'}</span><div class="verdict-track"><i style={`--p:${verdict.oneX2[side] * 100}%`}></i></div><span class="verdict-value">{Math.round(verdict.oneX2[side] * 100)}%</span></div>)}
      </div>
      {marketsList.map(market => market.value != null && <div class="verdict-market"><span>{market.label}</span><strong>{Math.round(market.value * 100)}%</strong></div>)}
      <span class="chapter-note">Evaluación histórica publicada sobre {evaluation.ensemble?.oneX2?.sampleSize ?? 0} partidos evaluados. No es una cuota ni un consejo de apuesta.</span>
     </> : <>
      <span class="outline-label">Evaluación en curso</span>
      <p>El veredicto combina los insumos de arriba; los porcentajes aparecen cuando la evaluación histórica supere a su baseline. Hoy hay {evaluation.poisson?.oneX2?.sampleSize ?? 0} partidos evaluados en la base.</p>
      <p class="verdict-direction">Con estos insumos, la lectura apunta a <strong>{direction ?? 'el empate'}</strong> — con la reserva de siempre: la muestra corta no demuestra el futuro.</p>
     </>}
     <span class="chapter-note">Fuente de los porcentajes del proveedor: Bzzoiro (modelo CatBoost). La combinación es de GoatLab y se evalúa contra resultados reales.</span>
    </> : <h3>Escenarios en preparación</h3><p class="chapter-note">Cuando existan suficientes datos de forma para ambos equipos, el veredicto aparecerá aquí con sus insumos y pesos declarados.</p>}</div>
   <div class="stage-source">Datos de proveedores deportivos · las estimaciones se identifican como tales</div>
  </div>
 </div>
 <AdSlot variant="rect" slotKey="partidoStory"/>
  <PitchScene match={match} events={events}/>
  <AdSlot variant="horizontal" slotKey="partidoCancha"/>
   {ai && (aiSections.length > 0 || aiLimits.length > 0) && <div class="pitch-reading"><h3>La lectura</h3>{aiSections.map(section => <div class="reading-section">{section.title && <h4>{section.title}</h4>}<ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul></div>)}{aiLimits.length > 0 && <ul class="reading-limits chapter-note">{aiLimits.map(limit => <li><strong>{limit.label}:</strong> {limit.detail}</li>)}</ul>}</div>}
    <AdSlot variant="rect" slotKey="partidoCierre"/>
  <TrendsStrip home={match.home} away={match.away} homeShort={teamShort(match.home)} awayShort={teamShort(match.away)} unavailable={probability?.availability?.unavailablePlayers ?? match.lineups?.unavailablePlayers ?? null} extra={trendsExtra} />
</main>
<script>
 const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-stage]')];
 const panes=[...document.querySelectorAll<HTMLElement>('[data-pane]')];
 const chapters=[...document.querySelectorAll<HTMLElement>('[data-chapter]')];
 const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hideTimers=new WeakMap<HTMLElement,number>();
  let activeId=buttons.length ? buttons[0].dataset.stage! : '';
  let manualUntil=0;
 function activate(id:string){
  if(!id)return;
  buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.stage===id)));
  if(activeId===id)return;
  activeId=id;
  panes.forEach(p=>{
   const isTarget=p.dataset.pane===id;
   const timer=hideTimers.get(p);
   if(timer)window.clearTimeout(timer);
   if(isTarget){
    p.hidden=false;
    p.setAttribute('aria-hidden','false');
    p.classList.remove('is-leaving');
    requestAnimationFrame(()=>p.classList.add('is-active'));
   }else{
    p.setAttribute('aria-hidden','true');
    p.classList.remove('is-active');
    p.classList.add('is-leaving');
    const hide=()=>{if(p.dataset.pane!==activeId){p.classList.remove('is-leaving');p.hidden=true;}};
    if(reducedMotion)hide();
    else hideTimers.set(p,window.setTimeout(hide,240));
   }
  });
 }
 buttons.forEach(button=>button.addEventListener('click',()=>{manualUntil=Date.now()+1500;activate(button.dataset.stage!);document.getElementById(button.dataset.stage!)?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});}));
  if(!reducedMotion){let queued=false;const update=()=>{queued=false;if(Date.now()<manualUntil)return;const marker=innerWidth<761?innerHeight*.7:innerHeight*.45;let current=chapters[0];for(const chapter of chapters){if(chapter.getBoundingClientRect().top<marker)current=chapter;}if(current)activate(current.dataset.chapter!);};window.addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(update);}},{passive:true});}
  // Tendencias: una sola pasada de entrada al aparecer en vista; sin JS todo queda visible.
  try{const trends=document.querySelector('.trends');if(trends&&!reducedMotion&&'IntersectionObserver' in window){const io=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting)){trends.classList.add('is-in');io.disconnect();}},{threshold:0.2});io.observe(trends);}}catch{/* visible sin animación */}
  document.querySelectorAll<HTMLTimeElement>('time[datetime]').forEach(time=>{const date=new Date(time.dateTime);if(!Number.isNaN(date.getTime())){time.textContent=new Intl.DateTimeFormat('es',{dateStyle:'medium',timeStyle:'short'}).format(date);const sibling=time.nextSibling;if(sibling?.textContent?.includes('(Lima)'))sibling.textContent=' (tu hora local)';}});
 // La última consulta se escribe en la hora del visitante con formato fijo (todas las apariciones).
 (()=>{
  const stamps=[...document.querySelectorAll<HTMLElement>('[data-consult]')];
  if(!stamps.length)return;
  let zone='UTC';
  try{zone=Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC';}catch{/* sin zona disponible */}
  for(const stamp of stamps){
   const iso=stamp.dataset.utc;
   if(!iso)continue;
   const date=new Date(iso);
   if(Number.isNaN(date.getTime()))continue;
   const parts=new Intl.DateTimeFormat('sv-SE',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(date);
   const read=(type:string)=>parts.find(part=>part.type===type)?.value??'';
   stamp.textContent=`${read('year')}-${read('month')}-${read('day')} ${read('hour')}:${read('minute')}`;
  }
 })();
</script>
</Layout>
