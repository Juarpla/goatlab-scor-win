---
/**
 * WaffleKicker.astro — pictograma del rematador en matriz de puntos.
 * Calca la referencia del usuario (silueta sólida: cabeza redonda arriba,
 * brazos en aspa afilados, apoyo vertical en punta, remate en diagonal
 * hacia el balón pequeño) con la técnica del mapa de la jornada
 * (`scripts/generate-world-dots.mjs`): retícula uniforme (pitch 6,
 * radio 1.8, misma proporción punto/celda que el mundo), punto presente
 * o ausente, verde tierra (#3a453c) con luz de borde en serie-mute
 * (#55645a) por arriba-derecha para darle volumen. Retícula fina para un
 * contorno más fiel y viewBox ceñido a los puntos para un centrado óptico.
 * Decorativo; el único movimiento es el balón.
 */
const PITCH = 6;
const R = 1.8;
const W = 240;
const H = 240;

const HEAD = [148, 46, 25];
const HIP = [95, 145, 13];
const TORSO = [[80, 60], [142, 76], [124, 108], [110, 146], [74, 142], [66, 106]];
// [ax, ay, bx, by, r0, r1] — miembros afilados como la referencia.
const TAPERS = [
  [92, 66, 36, 54, 9, 1],        // brazo izquierdo, en alto
  [136, 80, 193, 118, 9, 1],     // brazo derecho, al frente y abajo
  [88, 140, 98, 178, 13, 9],     // apoyo: muslo
  [98, 178, 117, 226, 9, 1],     // apoyo: pierna hasta la punta
  [100, 146, 212, 194, 12, 1.5], // remate en diagonal al balón
];
const BALL = [210, 161, 13];

const inCircle = (x, y, cx, cy, r) => (x - cx) ** 2 + (y - cy) ** 2 <= r * r;
const inTaper = (x, y, ax, ay, bx, by, r0, r1) => {
  const dx = bx - ax, dy = by - ay;
  const t = Math.min(1, Math.max(0, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy)));
  return Math.hypot(x - (ax + t * dx), y - (ay + t * dy)) <= r0 + (r1 - r0) * t;
};
// Mismo test de interior que generate-world-dots.mjs.
const inPoly = (x, y, p) => {
  let hit = false;
  for (let i = 0, j = p.length - 1; i < p.length; j = i++) {
    const [xi, yi] = p[i], [xj, yj] = p[j];
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) hit = !hit;
  }
  return hit;
};

const isSil = (x, y) =>
  inCircle(x, y, ...BALL) ||
  inCircle(x, y, ...HEAD) ||
  inCircle(x, y, ...HIP) ||
  inPoly(x, y, TORSO) ||
  TAPERS.some(([ax, ay, bx, by, r0, r1]) => inTaper(x, y, ax, ay, bx, by, r0, r1));
// Luz desde arriba-derecha: el punto cuyo vecino en esa dirección queda
// fuera de la silueta lleva el tono claro del borde.
const isRim = (x, y) => !isSil(x + 4, y - 4);

const figure = [];
const ball = [];
for (let y = PITCH / 2; y < H; y += PITCH) {
  for (let x = PITCH / 2; x < W; x += PITCH) {
    if (inCircle(x, y, ...BALL)) { ball.push({ x, y, cls: isRim(x, y) ? 'wk-rim' : 'wk-land' }); continue; }
    if (
      inCircle(x, y, ...HEAD) ||
      inCircle(x, y, ...HIP) ||
      inPoly(x, y, TORSO) ||
      TAPERS.some(([ax, ay, bx, by, r0, r1]) => inTaper(x, y, ax, ay, bx, by, r0, r1))
    ) figure.push({ x, y, cls: isRim(x, y) ? 'wk-rim' : 'wk-land' });
  }
}
// Encuadre ceñido a los puntos: centrado óptico en cualquier retoque.
const all = [...figure, ...ball];
const xs = all.map(dot => dot.x);
const ys = all.map(dot => dot.y);
const PAD = R + 6;
const vx = Math.floor(Math.min(...xs) - PAD);
const vy = Math.floor(Math.min(...ys) - PAD);
const vw = Math.ceil(Math.max(...xs) - vx + PAD);
const vh = Math.ceil(Math.max(...ys) - vy + PAD);
const viewBox = `${vx} ${vy} ${vw} ${vh}`;
---
<figure class="waffle-kicker" aria-hidden="true">
  <svg viewBox={viewBox} preserveAspectRatio="xMidYMid meet" role="presentation" focusable="false">
    <g>
      {figure.map(dot => <circle cx={dot.x} cy={dot.y} r={R} class={dot.cls} />)}
    </g>
    <g class="wk-ball">
      {ball.map(dot => <circle cx={dot.x} cy={dot.y} r={R} class={dot.cls} />)}
    </g>
  </svg>
</figure>
