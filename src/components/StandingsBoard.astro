---
import { teamEsDisplay } from '../lib/teams.js';
const { tables = {} } = Astro.props;
const NAMES = { premier: 'Premier League', laliga: 'LaLiga', champions: 'Champions League', libertadores: 'Libertadores', europa: 'Europa League' };
const teams = Object.entries(tables).filter(([, table]) => table.rows?.length);
---
<div class="panel standings">
 {teams.length ? <>
  <div class="chart-heading"><h3>La tabla al día</h3><span>{teams[0][1].season} · Football-Data.org</span></div>
  <div class="standings-tabs" role="group" aria-label="Elegir competición">
   {teams.map(([id], index) => <button class:list={['filter', { active: index === 0 }]} data-tab={id} aria-pressed={index === 0 ? 'true' : 'false'}>{NAMES[id] ?? id}</button>)}
  </div>
  {teams.map(([id, table], index) => (
   <table class="standings-table" data-panel={id} hidden={index !== 0}>
    <caption class="sr-only">Top 10 de {NAMES[id] ?? id}, temporada {table.season}</caption>
    <thead class="sr-only"><tr><th>Pos</th><th>Equipo</th><th>PJ</th><th>DG</th><th>PTS</th></tr></thead>
     <tbody>
      {table.rows.slice(0, 10).map(row => (
      <tr>
       <td class="st-pos">{row.position}</td>
        <td class="st-team">{teamEsDisplay(row.team)}</td>
       <td class="st-num">{row.played}</td>
       <td class="st-num">{row.goalDifference > 0 ? `+${row.goalDifference}` : row.goalDifference}</td>
       <td class="st-pts">{row.points}</td>
      </tr>
     ))}
    </tbody>
   </table>
  ))}
  <p class="panel-note">PJ jugados · DG diferencia de goles · PTS puntos. Top 10 de la temporada vigente.</p>
 </> : <>
  <div class="chart-heading"><h3>La tabla al día</h3><span>sin datos en la última actualización</span></div>
  <p class="standings-empty">Las tablas de la temporada no llegaron con la última corrida de datos. Vuelven con la próxima actualización diaria; mientras tanto, el muro de encuentros sigue a la vista.</p>
 </>}
</div>
<script>
 const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
 const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
 tabs.forEach(tab => tab.addEventListener('click', () => {
  tabs.forEach(button => {
   const on = button === tab;
   button.classList.toggle('active', on);
   button.setAttribute('aria-pressed', String(on));
  });
  panels.forEach(panel => (panel.hidden = panel.dataset.panel !== tab.dataset.tab));
 }));
</script>
