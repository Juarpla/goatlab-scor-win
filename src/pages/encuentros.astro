---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import MatchCard from '../components/MatchCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { competitions, FINISHED_STATUSES, isMatchExpired } from '../lib/football.js';
import { matchForm } from '../lib/form.js';
import fixtures from '../../public/data/fixtures.json';
import results from '../../public/data/results.json';
import '../styles/home.css';

const matches = [...fixtures.matches].sort((a, b) => (a.kickoff < b.kickoff ? -1 : 1));
const CODES = { champions: 'UCL', europa: 'UEL', libertadores: 'LIB', laliga: 'LAL', premier: 'EPL', nations: 'UNL' };
const competitionById = id => competitions.find(c => c.id === id) ?? null;
const kickoffLabel = kickoff => new Date(kickoff).toLocaleDateString('es-PE', { timeZone: 'America/Lima', day: 'numeric', month: 'short' }) + ' · ' + new Date(kickoff).toLocaleTimeString('es-PE', { timeZone: 'America/Lima', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
const dayLabel = kickoff => new Date(kickoff).toLocaleDateString('es-PE', { timeZone: 'America/Lima', weekday: 'short', day: 'numeric', month: 'short' });
// Solo lo vivo: sin finalizados y dentro de la ventana estimada de juego (90' + descanso + 10').
const rows = matches.filter(match => !FINISHED_STATUSES.has(match.status) && !isMatchExpired(match)).map(match => ({ ...match, form: matchForm(results.results, match.home, match.away) }));
const days = [...new Set(rows.map(match => match.kickoff.slice(0, 10)))];
const updated = fixtures.updatedAt ? new Date(fixtures.updatedAt).toLocaleString('es-PE', { timeZone: 'America/Lima' }) : null;
// Orden del muro, distinto del array global: LaLiga y Premier primero.
const wallCompetitions = ['laliga', 'premier', 'champions', 'europa', 'libertadores', 'nations'].map(id => competitions.find(c => c.id === id)).filter(Boolean);
const cardProps = m => ({ match: m, competitionCode: CODES[m.competition] ?? 'FUT', competitionName: competitionById(m.competition)?.name ?? '', kickoffLabel: kickoffLabel(m.kickoff), formHome: m.form?.homeForm ?? null, formAway: m.form?.awayForm ?? null });
---
<Layout title="Encuentros — GoatLab" description="La ventana completa de siete días: filtra por liga, día o estado y busca por equipo o estadio.">
<main id="main" class="wrap">
 <section class="intro">
  <div><h1>Todos los<br/><span>encuentros.</span></h1></div>
  <p>La ventana completa de siete días de nuestras competiciones, ordenada por kickoff{updated ? ` · actualizado ${updated} (Lima)` : ''}. Los horarios se muestran en tu hora local. Cada encuentro permanece hasta el final estimado de su juego (90' + descanso + 10'); después sale del muro.</p>
 </section>
 <section class="wall wall--ads" aria-labelledby="wall-title" style="padding-top:0;border-top:0;margin-top:0">
  <div class="section-heading"><h2 id="wall-title" class="sr-only">El muro de encuentros</h2><span>Cada tarjeta abre el análisis del partido</span></div>
  <div class="filter-row">
   <div class="competition-filters" role="group" aria-label="Filtrar por competición">
    <button class="filter active" data-league="all" aria-pressed="true">Todos</button>
    {wallCompetitions.map(c => <button class="filter" data-league={c.id} aria-pressed="false">{c.name}</button>)}
   </div>
   <div class="filter-row-side">
    <select id="day-select" class="day-select" aria-label="Filtrar por día">
     <option value="all" selected>Todo el periodo</option>
     {days.map(day => <option value={day}>{dayLabel(`${day}T12:00:00Z`)}</option>)}
    </select>
    <div class="competition-filters" role="group" aria-label="Filtrar por estado">
     <button class="filter active" data-status="all" aria-pressed="true">Todos</button>
     <button class="filter" data-status="upcoming" aria-pressed="false">Próximos</button>
     <button class="filter" data-status="live" aria-pressed="false">En vivo</button>
    </div>
   </div>
   <label class="search"><Icon name="search" size={18}/><input type="search" id="team-search" placeholder="Buscar equipo o estadio" aria-label="Buscar equipo o estadio"/></label>
  </div>
  <AdSlot variant="horizontal" class="ad-under-filters"/>
  <div class="wall-lead" id="wall-lead"></div>
  <div class="wall-body">
   <AdSlot variant="vertical" class="ad-rail"/>
  <div class="wall-center">
   <div class="wall-grid" id="wall-grid">
    {rows.map(m => <MatchCard {...cardProps(m)}/>)}
   </div>
   <p id="filter-empty" class="empty-message" hidden>No hay encuentros con ese filtro. Prueba otra liga, otro día u otro estado, o busca por otro nombre.</p>
   <p id="filter-count" class="sr-only" aria-live="polite"></p>
   <button id="wall-more" class="wall-more" type="button" hidden><span>Mostrar más</span><Icon size={16}/></button>
  </div>
   <AdSlot variant="vertical" class="ad-rail"/>
  </div>
  <AdSlot variant="horizontal"/>
 </section>
</main>
<script>
 import { initLocalTimes } from '../lib/local-time.js';
 initLocalTimes();
 const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-league]')];
 const statusFilters=[...document.querySelectorAll<HTMLButtonElement>('[data-status]')];
 const cards=[...document.querySelectorAll<HTMLElement>('[data-fixture]')];
 const search=document.querySelector<HTMLInputElement>('#team-search')!;
 const daySelect=document.querySelector<HTMLSelectElement>('#day-select')!;
 const lead=document.querySelector<HTMLElement>('#wall-lead')!;
 const grid=document.querySelector<HTMLElement>('#wall-grid')!;
 const empty=document.querySelector<HTMLElement>('#filter-empty')!;
 const count=document.querySelector<HTMLElement>('#filter-count')!;
 const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 const wide=window.matchMedia('(min-width:1150px)');
 let league='all', status='all';
 const normalize=(text:string)=>text.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
 // Paginación suave: 9 tarjetas en escritorio (fila de 3 + 3 filas de muro),
 // 6 en tablet (3 filas de 2) y 6 en mobile (6 filas de 1). Cada clic añade
 // 3 filas más (6 tarjetas escritorio/tablet, 3 mobile).
 // Sin JS el muro completo queda visible: la paginación es mejora progresiva.
 const compact=window.matchMedia('(max-width:760px)');
 const COLS=()=>compact.matches?1:2;
 const STEP=()=>3*COLS();
 const INITIAL=()=>wide.matches?STEP()+3:6;
 const moreBtn=document.querySelector<HTMLButtonElement>('#wall-more')!;
 const moreLabel=moreBtn.querySelector('span')!;
 const wallBody=document.querySelector<HTMLElement>('.wall-body')!;
 let shown=0;
 function update(mode:'all'|'new'|'silent', from=0){
  const query=normalize(search.value), day=daySelect.value;
  for(const card of cards){
   const show=(league==='all'||card.dataset.leagueId===league)&&(day==='all'||card.dataset.date===day)&&(status==='all'||card.dataset.stage===status)&&(card.dataset.teams||'').includes(query);
   card.hidden=!show;
  }
  const visible=cards.filter(card=>!card.hidden);
  const cut=Math.min(shown,visible.length);
  const batch=visible.slice(0,cut);
  // Escritorio: la primera fila lleva los 3 primeros visibles y el resto fluye al masonry.
  // En tablet/mobile la fila de 3 no existe (la card no cabe tan angosta): todo va al masonry.
  if(wide.matches){
   lead.replaceChildren(...batch.slice(0,3));
   grid.replaceChildren(...batch.slice(3),...cards.filter(card=>card.hidden));
  }else{
   lead.replaceChildren();
   grid.replaceChildren(...batch,...cards.filter(card=>card.hidden));
  }
  const remaining=visible.length-cut;
  moreBtn.hidden=remaining===0;
  if(remaining>0)moreLabel.textContent=`Mostrar ${remaining} ${remaining===1?'encuentro':'encuentros'} más`;
  empty.hidden=visible.length>0;
  count.textContent=`${visible.length} ${visible.length===1?'encuentro':'encuentros'}`;
  // Con pocos resultados el riel de 600px dominaría una vista casi vacía:
  // los rieles se retiran y el resultado ocupa todo el ancho.
  wallBody.classList.toggle('is-thin',wide.matches&&visible.length<=3);
  // Filtros: la cascada re-entra completa. "Mostrar más": solo los recién llegados.
  if(mode!=='silent'&&!reduce)batch.slice(from).forEach((card,index)=>{
   card.style.animation='none';void card.offsetWidth;
   card.style.animation=`card-in .55s cubic-bezier(.2,.8,.2,1) ${Math.min(cut-batch.slice(from).length+index,10)*45}ms both`;
  });
 }
 const reset=()=>{shown=INITIAL();update('all');};
 wide.addEventListener('change',()=>{shown=Math.max(shown,INITIAL());update('silent');});
 compact.addEventListener('change',()=>{shown=Math.max(shown,INITIAL());update('silent');});
 filters.forEach(button=>button.addEventListener('click',()=>{league=button.dataset.league!;filters.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});reset();}));
 statusFilters.forEach(button=>button.addEventListener('click',()=>{status=button.dataset.status!;statusFilters.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});reset();}));
 search.addEventListener('input',()=>{shown=INITIAL();update('silent');});
 daySelect.addEventListener('change',reset);
 moreBtn.addEventListener('click',()=>{
  const visible=cards.filter(card=>!card.hidden);
  const from=Math.min(shown,visible.length);
  shown=Math.min(shown+STEP(),visible.length);
  update('new',from);
 });
 shown=INITIAL();
 update('all');
</script>
</Layout>
