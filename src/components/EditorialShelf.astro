---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import '../styles/editorial.css';

const { preview = false } = Astro.props;
const articles = (await getCollection('editorial')).sort((a, b) => a.data.order - b.data.order);
const visible = preview ? articles.slice(0, 2) : articles;
---
<section class="editorial-shelf" aria-labelledby="editorial-shelf-title">
  {preview && <div class="editorial-shelf-heading">
    <h2 id="editorial-shelf-title">El Juego en Datos.</h2>
    <a href="/el-juego-en-datos/">Todos los artículos <Icon size={16}/></a>
  </div>}
  {!preview && <h2 class="sr-only" id="editorial-shelf-title">Todos los artículos</h2>}
  <ul class="editorial-grid" role="list">
    {visible.map(({ id, data }) => <li>
      <article class:list={['editorial-card', { 'editorial-card-featured': data.figure }]}>
        <a href={`/el-juego-en-datos/${id}/`}>
          <span class="editorial-category">{data.category}</span>
          <h3>{data.title}</h3>
          <p>{data.description}</p>
          <span class="editorial-arrow" aria-hidden="true"><Icon size={19}/></span>
        </a>
      </article>
    </li>)}
  </ul>
</section>
