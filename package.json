{
  "name": "goatlab",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/write-ads-txt.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "lint:shorts": "node scripts/check-compliance.mjs",
    "shorts": "node scripts/generate-youtube-scripts.mjs",
    "data:update": "node --env-file=.env scripts/update-data.mjs",
    "data:teams": "node --env-file=.env scripts/build-teams.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.3.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "4.131.2"
  }
}
