---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import Layout from '../../../layouts/Layout.astro';
import { attentionPlayers, playersInNarration, shortTitle, youtubeCopy } from '../../../lib/youtube.js';

export function getStaticPaths() {
  let files = [];
  try {
    files = readdirSync('public/data/youtube-scripts').filter(f => f.endsWith('.json'));
  } catch {
    return [];
  }
  return files.map(file => {
    const data = JSON.parse(readFileSync(`public/data/youtube-scripts/${file}`, 'utf8'));
    return { params: { id: data.matchId }, props: { data } };
  });
}

const { data } = Astro.props;
const title = `${data.home} contra ${data.away}: guiones del Short | GoatLab`;
const creditPath = 'fly/render/assets/bed.txt';
const credit = existsSync(creditPath) ? readFileSync(creditPath, 'utf8') : '';
const packPath = `public/data/media-pack/${data.matchId}.json`;
const attribution = existsSync(packPath)
  ? JSON.parse(readFileSync(packPath, 'utf8')).attribution
  : '';
const named = { home: data.home, away: data.away };
const players = attentionPlayers(data.scripts, named);
const scripts = data.scripts.map((script) => ({
  ...script,
  title: shortTitle({
    ...named,
    n: script.n,
    hook: script.hook,
    players: [3, 4, 7, 9].includes(Number(script.n)) ? playersInNarration(script.narration, named) : [],
  }),
}));
const youtubeDescription = youtubeCopy({
  lede: data.description,
  matchId: data.matchId,
  home: data.home,
  away: data.away,
  competition: data.competition,
  players,
  attribution,
  credit,
});
---

<Layout title={title} description={`Diez guiones de Short y descripción lista para YouTube del ${data.home} contra ${data.away}.`} canonical={`https://goatlab.win/partido/${data.matchId}/youtube`}>
  <main id="main" class="wrap">
    <p><a href={`/partido/${data.matchId}/`}>← Volver al análisis del partido</a></p>
    <h1>{data.home} contra {data.away}</h1>
    <p>Diez títulos para el Short, el gancho de cada uno y la descripción lista para copiar en YouTube.</p>
    <h2>Descripción para YouTube</h2>
    <pre>{youtubeDescription}</pre>
    <h2>Títulos y guiones</h2>
    <ol>
      {scripts.map((script) => (
        <li>
          <p><strong>{script.title}</strong></p>
          <p>{script.narration}</p>
          <p><small>Guion {script.n} · {script.words} palabras (~{Math.round(script.words / 2.5)}s) · gancho: {script.hook}</small></p>
        </li>
      ))}
    </ol>
  </main>
</Layout>
