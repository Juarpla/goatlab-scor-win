---
/**
 * Camiseta estimada de un equipo en SVG, pintada con sus colores curados
 * (src/lib/team-colors.js) y recorrida por un escaneo cuadricular del verde
 * de la web — un radar, no una decoración; queda recortado a la prenda.
 * Con movimiento reducido la banda se congela a media opacidad.
 * `pattern` opcional: 'stripes' | 'sash' | 'plain'.
 */
import { teamColors } from '../lib/team-colors.js';

const { name, short, pattern, side = 'home' } = Astro.props;
const colors = teamColors(name);
const stripePattern = pattern === 'stripes';
const sash = pattern === 'sash';
const BODY = 'M40 14 14 28 4 14 12 4C24 0 40 0 60 0s36 0 48 4l8 10-10 14-26-14v96c-6 4-34 4-40 0Z';
const uid = `jersey-${side}`;
---

<figure class="jersey">
  <div class="jersey-wrap">
    <svg viewBox="0 0 120 116" role="img" aria-label={`Camiseta estimada de ${name}`}>
      <defs>
        <clipPath id={`${uid}-clip`}><path d={BODY}/></clipPath>
        <pattern id={`${uid}-grid`} width="7" height="7" patternUnits="userSpaceOnUse">
          <path d="M7 0H0v7" fill="none" stroke="rgba(197,237,116,.32)" stroke-width="0.8"/>
        </pattern>
        <linearGradient id={`${uid}-band`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#fff" stop-opacity="0"/>
          <stop offset="0.42" stop-color="#fff"/>
          <stop offset="0.58" stop-color="#fff"/>
          <stop offset="1" stop-color="#fff" stop-opacity="0"/>
        </linearGradient>
        <mask id={`${uid}-mask`}><rect x="-48" y="-10" width="56" height="140" fill={`url(#${uid}-band)`}/></mask>
      </defs>
      <path d={BODY} fill={colors.primary}/>
      <g clip-path={`url(#${uid}-clip)`}>
        {stripePattern && <>
          <rect x="30" y="-6" width="14" height="128" fill={colors.secondary} transform="rotate(-4 37 58)"/>
          <rect x="58" y="-6" width="14" height="128" fill={colors.secondary} transform="rotate(-4 65 58)"/>
          <rect x="86" y="-6" width="14" height="128" fill={colors.secondary} transform="rotate(-4 93 58)"/>
        </>}
        {sash && <path d="M14 22 96 116h16L24 16Z" fill={colors.secondary}/>}
        <rect class="scan-band" x="-48" y="-10" width="56" height="140" fill={`url(#${uid}-grid)`} mask={`url(#${uid}-mask)`}/>
      </g>
      <path d="M48 2c4 8 20 8 24 0" fill="none" stroke={colors.secondary} stroke-width="5"/>
      <path d={BODY} fill="none" stroke="rgba(16,20,18,.35)" stroke-width="2"/>
      <path d="M40 104c6 4 34 4 40 0" fill="none" stroke={colors.secondary} stroke-width="4"/>
    </svg>
  </div>
  <figcaption>{short}</figcaption>
</figure>

<style is:global>
  .scan-band { animation: jersey-scan 5.8s cubic-bezier(0.45, 0, 0.25, 1) infinite; }
  .jerseys .jersey:nth-child(3) .scan-band { animation-delay: 1.5s; }
  @keyframes jersey-scan {
    0% { transform: translateX(0); }
    14% { opacity: 1; }
    58% { opacity: 1; }
    72%, 100% { transform: translateX(172px); opacity: 0; }
  }
  .scan-band { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .scan-band { animation: none; transform: translateX(20px); opacity: 0.45; }
  }
</style>
