---
/**
 * Contexto pendiente del encuentro: sede, clima y disponibilidad.
 * La lectura del proveedor (Bzzoiro) vive como marcador lateral dentro de
 * los capítulos de resultado y goles; el historial cara a cara no se muestra.
 * Mismo mundo de la sala de análisis: superficies mate, regla de 1px,
 * fichas con ícono y notas quietas. Todo bloque ausente se omite.
 */
import Icon from './Icon.astro';

interface Props {
  discipline?: any;
  setPieces?: any;
  weatherVenue?: any;
  availability?: any;
}

const { discipline, setPieces, weatherVenue, availability } = Astro.props;
const num = (value: number | null | undefined, digits = 1) => value == null ? '—' : Number(value).toFixed(digits);
/* Condición en español: el proveedor la sirve en inglés (`clear`) u Open-Meteo
   con código WMO; el viento se muestra en km/h y la temperatura en °C. */
const CONDITION_ES: Record<string, string> = {
  clear: 'despejado', sunny: 'soleado', cloudy: 'nublado', overcast: 'cubierto',
  'partly cloudy': 'parcialmente nublado', fog: 'niebla', drizzle: 'llovizna',
  rain: 'lluvia', snow: 'nieve', thunderstorm: 'tormenta', showers: 'chubascos',
};
const WMO_ES: Record<number, string> = {
  0: 'despejado', 1: 'casi despejado', 2: 'parcialmente nublado', 3: 'cubierto',
  45: 'niebla', 48: 'niebla', 51: 'llovizna', 53: 'llovizna', 55: 'llovizna',
  61: 'lluvia', 63: 'lluvia', 65: 'lluvia fuerte', 71: 'nieve', 73: 'nieve',
  75: 'nieve fuerte', 80: 'chubascos', 81: 'chubascos', 82: 'chubascos fuertes', 95: 'tormenta',
};
const hasAvailability = Boolean(availability && (availability.unavailablePlayers?.length || availability.status));
const expectedCards = discipline?.expectedTotal ?? null;
const expectedCorners = setPieces?.expectedTotal ?? null;
const cardsSource = discipline?.source ?? null;
const cornersSource = setPieces?.source ?? null;
const hasModels = Boolean(expectedCards != null || expectedCorners != null || (discipline && discipline.source) || (setPieces && setPieces.source));

const rawCondition = weatherVenue?.weather?.condition;
const rawCode = weatherVenue?.weather?.weathercode;
const conditionEs = (typeof rawCondition === 'string' && CONDITION_ES[rawCondition.toLowerCase()])
  ?? (typeof rawCode === 'number' ? WMO_ES[rawCode] ?? null : null)
  ?? (typeof rawCondition === 'string' && !['unknown', 'desconocido', 'n/a'].includes(rawCondition.toLowerCase()) ? rawCondition : null);
const weatherBits = [
  weatherVenue?.weather?.temp != null ? `${num(weatherVenue.weather.temp, 0)} °C` : null,
  weatherVenue?.weather?.wind != null ? `viento ${num(weatherVenue.weather.wind, 0)} km/h` : null,
  conditionEs,
].filter(Boolean);
const weatherLabel = weatherBits.length ? weatherBits.join(' · ') : null;
const hasWeather = Boolean(weatherVenue && (weatherLabel || weatherVenue.venue?.stadium));
const allEmpty = !hasWeather && !hasAvailability && !hasModels;
const venueLabel = weatherVenue?.venue?.stadium
  ? `${weatherVenue.venue.stadium}${weatherVenue.venue.city ? ` · ${weatherVenue.venue.city}` : ''}`
  : null;
const absentRows = availability?.unavailablePlayers ?? [];
---
{allEmpty ? (
  <p class="chapter-note">Del contexto del encuentro, en preparación: cuando haya clima, árbitro o bajas confirmadas, aparecerán aquí con su fuente.</p>
) : (
  <div class="extra-markets">
    {(hasWeather || hasAvailability) && (
      <ul class="prob-chips">
        {weatherLabel && <li><Icon name="bolt" size={16} /><span>Clima al saque</span><strong>{weatherLabel}</strong></li>}
        {venueLabel && <li><Icon name="shield" size={16} /><span>Sede</span><strong>{venueLabel}</strong></li>}
        {hasAvailability && absentRows.length > 0 && <li><Icon name="star" size={16} /><span>Bajas confirmadas</span><strong>{absentRows.length}</strong></li>}
      </ul>
    )}
    {(expectedCards != null || expectedCorners != null) && (
      <ul class="prob-chips">
        {expectedCards != null && <li><Icon name="star" size={16} /><span>Amarillas esperadas</span><strong>~{num(expectedCards)}</strong><small>Procedencia: {cardsSource ?? 'Estimación'}</small></li>}
        {expectedCorners != null && <li><Icon name="bolt" size={16} /><span>Córners esperados</span><strong>~{num(expectedCorners)}</strong><small>Procedencia: {cornersSource ?? 'Estimación'}</small></li>}
      </ul>
    )}
    {!hasModels && (
      <p class="chapter-note">Tarjetas y córners en estimación: sin modelo evaluado aún, se muestran como esperados con su procedencia.</p>
    )}
  </div>
)}
<style>
  .extra-markets {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
