---
/**
 * ScorePodium.astro — the scorelines the calculation repeats most.
 * Three columns that grow on activation (.grow with staggered --d):
 * the podium tells the story, the rest accompanies in a discreet line.
 */
interface Score { home: number; away: number; p: number }
interface Props { title: string; scores: Score[]; rest?: string | null; summary: string }

const { title, scores, rest, summary } = Astro.props;
const pct = (value: number) => `${Math.round(value * 100)}%`;
const BASE = 148;
const top = Math.max(...scores.map(score => score.p), 0.01);
const colX = [8, 118, 228];
/* Bars from zero so differences read clearly; 8px floor. */
const height = (score: Score) => Math.max(8, (score.p / top) * 96);
---
<figure class="podium">
  <figcaption>{title}</figcaption>
  <svg viewBox="0 0 320 190" role="img" aria-label={summary}>
    <line class="ladder-step" x1="0" y1={BASE} x2="320" y2={BASE} aria-hidden="true"/>
    {scores.map((score, index) => {
      const bar = height(score);
      return (
        <g>
          <text class="podium-score" x={colX[index] + 42} y={BASE - bar - 26} text-anchor="middle">{score.home}–{score.away}</text>
          <text class="podium-pct" x={colX[index] + 42} y={BASE - bar - 10} text-anchor="middle">{pct(score.p)}</text>
          <rect class={`pod-${index + 1} pt-grow`} style={`--d:${(index * 0.14).toFixed(2)}s`} x={colX[index]} y={BASE - bar} width="84" height={bar} rx="4"/>
        </g>
      );
    })}
  </svg>
  {rest && <p class="podium-rest">{rest}</p>}
</figure>
