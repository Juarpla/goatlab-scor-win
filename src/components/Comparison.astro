---
const { home, away, shortHome, shortAway, homeForm, awayForm } = Astro.props;
// Oldest on the left, most recent labeled "Último" — same reading as always.
const homeGoals = [...homeForm.goalsFor].reverse();
const awayGoals = [...awayForm.goalsFor].reverse();
const homeTotal = homeForm.goalsFor.reduce((a, b) => a + b, 0);
const awayTotal = awayForm.goalsFor.reduce((a, b) => a + b, 0);
const step = Math.max(1, Math.ceil(Math.max(4, ...homeGoals, ...awayGoals) / 4));
const axisMax = step * 4;
const axis = [axisMax, axisMax - step, axisMax - 2 * step, axisMax - 3 * step, 0];
const count = Math.max(homeGoals.length, awayGoals.length);
const pairs = Array.from({ length: count }, (_, index) => [homeGoals[index], awayGoals[index]]);
---
<div class="comparison">
 <div class="chart-heading"><h3>Cómo llegan al encuentro</h3><span>{Math.max(homeForm.played, awayForm.played)} partidos · resultados reales</span></div>
 <div class="legend"><span><i class="home-dot"></i>{shortHome}</span><span><i class="away-dot"></i>{shortAway}</span></div>
 <div class="bar-chart" role="img" aria-label={`Goles reales en los últimos partidos: ${home}, ${homeGoals.join(', ')}; ${away}, ${awayGoals.join(', ')}`}>
  <div class="y-axis">{axis.map(value => <span>{value}</span>)}</div>
  <div class="plot">{pairs.map(([homeValue, awayValue], index) => <div class="bar-group"><div class="bars"><div class="bar home-bar" style={`--bar:${(homeValue ?? 0) / axisMax * 100}%`}><span>{homeValue ?? '–'}</span></div><div class="bar away-bar" style={`--bar:${(awayValue ?? 0) / axisMax * 100}%`}><span>{awayValue ?? '–'}</span></div></div><span class="x-label">{index === count - 1 ? 'Último' : `P${count - index}`}</span></div>)}</div>
 </div>
 <div class="chart-bottom"><span>Goles anotados por partido</span><span>{homeTotal} <small>vs.</small> {awayTotal} <small>en total</small></span></div>
</div>
