# Never use the ca- prefix here: the code derives it only where needed (script).
PUBLIC_ADSENSE_PUBLISHER_ID=pub-1972487168739114
# Never prefix private keys with PUBLIC_. Configure these in GitHub Secrets.
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
BZZOIRO_API_TOKEN=
MISTRAL_API_KEY=
# Official Mistral API. Do not point this at OpenCode Go: that gateway requires its own key.
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=ministral-8b-2512
WORKERS_AI_API_KEY=
WORKERS_AI_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_ACCOUNT_ID=
OPENCODE_GO_API_KEY=
# Shorts photo vision. Used by the content-selection scripts.
VISION_MAX_TOKENS=15000
VISION_CALL_MS=120000
VISION_PHASE_MAX_MS=600000
# Content: DeepSeek first and GLM as fallback, both with reasoning_effort=max.
OPENCODE_GO_MODEL=deepseek-v4.1-flash
# Same gateway and same OPENCODE_GO_API_KEY. 10 min and 131072 tokens per attempt.
OPENCODE_GO_FALLBACK_MODEL=glm-5.3-flash
# Photos generated only if, after vision, fewer than 4 remain. The key
# must be a Token Plan (Starter) key: Free keys use another pool with
# 1 video RPM and saturate. The key goes in secrets, never here with a value.
AGNES_API_KEY=
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_MAX_IMAGES=4
# Effective TokenPlan pace: 80 RPM at 2K, 5 RPM for video.
AGNES_IMAGE_RPM=80
AGNES_VIDEO_START_INTERVAL=12.1
# Daily operative video cap (Starter quota: 500s/day; 360s ≈ 30 banks of 2 clips).
AGNES_DAILY_VIDEO_SECONDS_CAP=360
AGNES_DAILY_IMAGE_CAP=4000
MEDIA_RUN_BUDGET_MS=3000000
TOP_MAX_AGE_HOURS=7
# Private state: reuses the existing R2 keys; optional overrides (see AGNES-STATE.md).
R2_STATE_ACCOUNT_ID=
R2_STATE_BUCKET=app-states
R2_STATE_KEY=goatlab/agnes-state.json
R2_STATE_ACCESS_KEY_ID=
R2_STATE_SECRET_ACCESS_KEY=
LLM_PROVIDER_ORDER=MISTRAL_MODEL,WORKERS_AI_MODEL,OPENCODE_GO_MODEL,OPENCODE_GO_FALLBACK_MODEL
# Per-task order. Empty = LLM_PROVIDER_ORDER.
ANALYSIS_PROVIDER_ORDER=MISTRAL_MODEL,WORKERS_AI_MODEL,OPENCODE_GO_MODEL,OPENCODE_GO_FALLBACK_MODEL
SCRIPT_PROVIDER_ORDER=OPENCODE_GO_MODEL,OPENCODE_GO_FALLBACK_MODEL,MISTRAL_MODEL,WORKERS_AI_MODEL
# Shorts scripts: how many matches from the relevance ranking per run (7-day window).
SCRIPT_TOP_N=5
# Daily API-Football predictions budget (1 request per af- match).
AF_PREDICTIONS_MAX=8
# Daily API-Football pre-match odds budget (1 request per af- match).
AF_ODDS_MAX=8
# Last-section fallback (/partido/): injuries (1) + squads (up to 2)
# per match without Bzzoiro extra, with the AF twin resolved by date.
AF_TRENDS_FALLBACK_MAX=8
# LLM readings retried per refresh run (only missing ones).
ANALYSIS_CATCHUP_MAX=3
# Matches with a pending reading per full/analysis-only run (nearest kickoff first).
ANALYSIS_FULL_MAX=10
# Analysis phase cap in the full run. What does not fit is left for catch-up.
ANALYSIS_PHASE_MAX_MS=360000
# Matches per LLM call in the discrete batch (1 = 1x1 only).
ANALYSIS_BATCH_SIZE=2
# Token ceiling for 1x1 analysis (first attempt and retry if it truncates or transport fails).
ANALYSIS_MAX_TOKENS=15000
ANALYSIS_RETRY_MAX_TOKENS=15000
# Token ceilings for the discrete batch (base and retry if it truncates).
ANALYSIS_BATCH_MAX_TOKENS=40000
ANALYSIS_BATCH_RETRY_MAX_TOKENS=40000
# Consecutive transport failures before pausing a provider in the run.
LLM_PROVIDER_BREAKER_MAX=3
# Deployment only, in GitHub Secrets:
CLOUDFLARE_API_TOKEN=
# Set CLOUDFLARE_PAGES_PROJECT as a GitHub repository variable.
