  <path class="cs-away ct-draw" pathLength="1" d="M64 88V62" stroke-width="7"/>
  <path class="cs-away ct-draw ct-d1" pathLength="1" d="M112 88V50" stroke-width="7"/>
  <path class="cs-signal ct-draw ct-d2" pathLength="1" d="M160 88V30" stroke-width="7"/>
  <path class="cs-away ct-draw ct-d3" pathLength="1" d="M208 88V56" stroke-width="7"/>
