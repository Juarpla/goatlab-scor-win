---
import { env } from 'cloudflare:workers';
import ArchivedMatch from '../../components/ArchivedMatch.astro';
import Layout from '../../layouts/Layout.astro';
import { competitions } from '../../lib/football.js';
import { teamEsDisplay } from '../../lib/teams.js';
import { describeMatch } from '../../lib/match-seo.js';
import MatchDetail from '../../components/MatchDetail.astro';
import MatchNotice from '../../components/MatchNotice.astro';
import { calendarPhase, fixtureIsIndexable, matchAvailability } from '../../lib/match-calendar.js';
import { matchCalendar, unavailableCalendar } from '../../lib/match-calendar-store.js';

export const prerender = false;

let record = null;
let updatedAt = null;
let status;
const now = Date.now();
try {
  const calendar = await matchCalendar(env);
  record = await calendar.get(Astro.params.id);
  updatedAt = calendar.updatedAt;
  status = matchAvailability(record, now);
} catch (error) {
  console.error('Match detail unavailable', error);
  status = 503;
  for (const [name, value] of Object.entries(unavailableCalendar())) Astro.response.headers.set(name, value);
}
if (status === 200 && record.slug !== Astro.params.id) {
  return Astro.redirect(`/partido/${record.slug}/`, 301);
}
const indexable = status === 200 && fixtureIsIndexable(record.match, record.indexable, now);
Astro.response.status = status;
Astro.response.headers.set('Cache-Control', 'no-store');
if (!indexable && status !== 503) Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
const phase = status === 200 ? calendarPhase(record.match, now) : null;
const home = record?.match ? teamEsDisplay(record.match.home) : '';
const away = record?.match ? teamEsDisplay(record.match.away) : '';
const name = `${home} vs. ${away}`;
const competition = competitions.find(item => item.id === record?.match?.competition)?.name;
---
{status === 503 ? <MatchNotice title="El calendario no está disponible" message="Vuelve a intentarlo en unos minutos."/> :
 status === 410 ? <MatchNotice title="Este encuentro se retiró" message="El calendario muestra la jornada actual y los próximos partidos."/> :
 status === 404 ? <MatchNotice title="Encuentro no encontrado" message="Consulta la jornada actual y los próximos partidos en el calendario."/> :
 phase === 'cancelled' ? <MatchNotice title={name} message="El proveedor ha comunicado que este encuentro se canceló o se dio por terminado sin disputarse por completo."/> :
 phase === 'final' ? <Layout title={`${name} — GoatLab`} description={describeMatch({ ...record.match, home, away, competition, finalScore: { home: record.match.homeScore, away: record.match.awayScore } })} robots="noindex, follow">
   <ArchivedMatch match={{ ...record.match, reading: record.reading }} home={home} away={away} competition={competition}/>
 </Layout> :
 <MatchDetail match={record.match} reading={record.reading} indexable={indexable} updatedAt={updatedAt}/>}
