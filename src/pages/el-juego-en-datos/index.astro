---
import { env } from 'cloudflare:workers';
import EditorialList from '../../components/EditorialList.astro';
import MatchNotice from '../../components/MatchNotice.astro';
import { editorialPage } from '../../lib/editorial-store.js';

export const prerender = false;
const page = await editorialPage(env.GOATLAB_DB, 1, Astro.response);
---
{page ? <EditorialList {...page}/> :
  <MatchNotice title="Datos jugados no está disponible" message="Vuelve a intentarlo en unos minutos."/>}
