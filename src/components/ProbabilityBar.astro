---
/**
 * Barra de probabilidad en SVG. Dos variantes:
 * - 'stack' (por defecto): una pista con segmentos que suman 100%.
 * - 'rows': una barra por segmento, para pares que se solapan (doble oportunidad).
 */
interface Segment { label: string; value: number | null; tone?: 'home' | 'away' | 'draw' | 'mute' }
interface Props { title: string; segments: Segment[]; note?: string; variant?: 'stack' | 'rows' }

const { title, segments = [], note, variant = 'stack' } = Astro.props;
const safe = segments.map(segment => ({ ...segment, value: Number.isFinite(segment.value) ? (segment.value as number) : 0 }));
const total = safe.reduce((sum, segment) => sum + segment.value, 0) || 1;
let cursor = 0;
const bars = safe.map(segment => {
  const width = variant === 'rows' ? segment.value * 100 : (segment.value / total) * 100;
  const bar = { tone: segment.tone ?? 'mute', x: cursor, width };
  cursor += width;
  return bar;
});
const pct = (value: number) => `${Math.round(value * 100)}%`;
const hasValues = segments.some(segment => Number.isFinite(segment.value));
---
<figure class="prob-bar">
  <figcaption>{title}</figcaption>
  {hasValues ? <>
    {variant === 'rows' ? (
      <ul class="prob-legend prob-legend-rows">
        {safe.map(segment => (
          <li>
            <span class="prob-row-head">
              <i class={`prob-key prob-${segment.tone ?? 'mute'}`} aria-hidden="true"></i><span>{segment.label}</span><strong>{pct(segment.value)}</strong>
            </span>
            <svg class="prob-row-track" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
              <rect class="prob-row-bg" x="0" y="0" width="100" height="6" rx="3"/>
              {segment.value > 0 && <rect class={`prob-fill prob-${segment.tone ?? 'mute'}`} x="0" y="0" width={Math.max(0.6, segment.value * 100)} height="6" rx="3"/>}
            </svg>
          </li>
        ))}
      </ul>
    ) : (
      <>
        <svg class="prob-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
          <rect class="prob-fill prob-mute" x="0" y="0" width="100" height="10" rx="3"/>
          {bars.filter(bar => bar.width > 0).map(bar => <rect class={`prob-fill prob-${bar.tone}`} x={bar.x} y="0" width={Math.max(0.6, bar.width)} height="10" rx="3"/>)}
        </svg>
        <ul class="prob-legend">
          {safe.map(segment => <li><i class={`prob-key prob-${segment.tone ?? 'mute'}`} aria-hidden="true"></i><span>{segment.label}</span><strong>{pct(segment.value)}</strong></li>)}
        </ul>
      </>
    )}
    {note && <p class="prob-note">{note}</p>}
  </> : <p class="prob-note">Sin datos suficientes para este mercado.</p>}
</figure>
