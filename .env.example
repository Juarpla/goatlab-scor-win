# Never prefix private keys with PUBLIC_. Configure these in GitHub Secrets.
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
BZZOIRO_API_TOKEN=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
WORKERS_AI_API_KEY=
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_ACCOUNT_ID=
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=glm-5.3-flash
LLM_PROVIDER_ORDER=MISTRAL_MODEL,WORKERS_AI_MODEL,OPENCODE_GO_MODEL
# Presupuesto diario de predicciones API-Football (1 request por partido af-).
AF_PREDICTIONS_MAX=8
# Presupuesto diario de odds pre-partido API-Football (1 request por partido af-).
AF_ODDS_MAX=8
# Fallback de la última sección (/partido/): injuries (1) + plantillas (hasta 2)
# por partido sin extra Bzzoiro, con gemelo AF resuelto por fecha.
AF_TRENDS_FALLBACK_MAX=8
# Lecturas LLM reintentadas por corrida de refresco (solo las ausentes).
ANALYSIS_CATCHUP_MAX=3
# Partidos con lectura pendiente por corrida full/analysis-only (kickoff más próximo primero).
ANALYSIS_FULL_MAX=10
# Partidos por llamada LLM en batch discreto (1 = solo 1x1).
ANALYSIS_BATCH_SIZE=2
# Techo de tokens del reintento 1x1 cuando la respuesta sale truncada.
ANALYSIS_RETRY_MAX_TOKENS=5000
# Techos de tokens del batch (base y reintento si trunca).
ANALYSIS_BATCH_MAX_TOKENS=6000
ANALYSIS_BATCH_RETRY_MAX_TOKENS=8000
# Fallos de transporte seguidos antes de pausar un proveedor en la corrida.
LLM_PROVIDER_BREAKER_MAX=3
# Deployment only, in GitHub Secrets:
CLOUDFLARE_API_TOKEN=
# Set CLOUDFLARE_PAGES_PROJECT as a GitHub repository variable.
MISTRAL_BASE_URL=https://opencode.ai/zen/go/v1
