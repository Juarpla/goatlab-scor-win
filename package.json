{
  "name": "goatlab",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/write-ads-txt.mjs && astro build && node scripts/check-site-publication.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "check:publication": "node scripts/check-site-publication.mjs",
    "lint:shorts": "node scripts/check-compliance.mjs",
    "shorts": "node actions/2-scripting/generate-youtube-scripts.mjs",
    "content": "node actions/2-scripting/generate-match-content.mjs",
    "lint:prompts": "node scripts/check-match-prompts.mjs",
    "media": "node actions/3-media-creation/generate-media-pack.mjs",
    "media:check": "node actions/3-media-creation/check-media-complete.mjs",
    "short": "node video-render/cli/render.mjs",
    "video:layout": "node video-render/cli/check-layout.mjs",
    "video:list": "node scripts/list-media-packs.mjs",
    "data:update": "node --env-file=.env actions/1-update-data/update-data.mjs",
    "data:teams": "node --env-file=.env scripts/build-teams.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.3.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "4.131.2"
  }
}
