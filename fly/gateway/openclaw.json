// GoatLab gateway on Fly (app goatlab-gateway).
// No secrets in this file: sensitive values are ${VAR} injected as Fly secrets.
// model-config.mjs applies GOATLAB_AGENT_MODELS at each boot. Legacy model
// selectors remain available to older content generators.
{
  gateway: {
    mode: "local",
    port: 3001,
    bind: "loopback",
    trustedProxies: ["127.0.0.1"],
    auth: {
      mode: "trusted-proxy",
      password: "${OPENCLAW_GATEWAY_PASSWORD}", // direct local CLI only
      trustedProxy: {
        userHeader: "x-forwarded-user",
        requiredHeaders: ["x-forwarded-proto", "x-forwarded-host"],
        allowUsers: ["telegram:${TELEGRAM_ALLOWED_USERS}"],
        allowLoopback: true,
        deviceAutoApprove: {
          enabled: true,
          scopes: ["operator.read", "operator.write", "operator.approvals", "operator.questions"],
        },
      },
    },
    controlUi: { allowedOrigins: ["https://goatlab-gateway.fly.dev"] },
  },
  browser: {
    enabled: true,
    defaultProfile: "openclaw",
    executablePath: "/usr/bin/chromium",
    headless: true,
    noSandbox: true, // dedicated Fly VM; CDP/control remain loopback-only
    snapshotDefaults: { mode: "efficient" },
    tabCleanup: { enabled: true },
    profiles: { openclaw: { cdpPort: 18800 } },
  },
  plugins: { entries: { browser: { enabled: true } } },
  tools: { alsoAllow: ["browser"] },
  agents: {
    defaults: {
      workspace: "/home/node/.openclaw/workspace",
      model: {
        primary: "opencode-go/${OPENCODE_GO_MODEL}",
        fallbacks: ["opencode-go/${OPENCODE_GO_FALLBACK_MODEL}"],
      },
      // No per-model params. OpenClaw does not substitute ${VAR} in object keys,
      // so a fixed override would keep pointing at a retired model id.
    },
  },
  models: {
    mode: "merge",
    providers: {
      agnes: { baseUrl: "https://apihub.agnes-ai.com/v1", apiKey: "${AGNES_API_KEY}", api: "openai-completions", models: [{ id: "agnes-3.0-flash", name: "Agnes 3.0 Flash", input: ["text"] }] },
      mistral: { baseUrl: "https://api.mistral.ai/v1", apiKey: "${MISTRAL_API_KEY}", api: "openai-completions", models: [{ id: "mistral-small-2603", name: "Mistral Small 4", input: ["text", "image"] }] },
      "opencode-go": {
        baseUrl: "https://opencode.ai/zen/go/v1",
        apiKey: "${OPENCODE_GO_API_KEY}",
        api: "openai-completions",
        headers: { "x-opencode-session": "goatlab-gateway", "User-Agent": "GoatLab-Gateway/3.0" },
        models: [
          { id: "mimo-v2.6-flash", name: "MiMo V2.6 Flash", input: ["text", "image"] },
          { id: "deepseek-v4.1-flash", name: "DeepSeek V4.1 Flash", input: ["text", "image"] },
        ],
      },
    },
  },
  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_ALLOWED_USERS}"],
      capabilities: { inlineButtons: "allowlist" },
      webhookUrl: "${TELEGRAM_PUBLIC_WEBHOOK_URL}",
      webhookPath: "/telegram-webhook",
      webhookSecret: "${TELEGRAM_WEBHOOK_SECRET}",
      webhookHost: "127.0.0.1",
      webhookPort: 8787,
    },
  },
}
